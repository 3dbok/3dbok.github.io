---
import BaseLayout from "../layouts/BaseLayout.astro";
import PiezaEnCapas from "../components/PiezaEnCapas.astro";
import MaterialChip from "../components/MaterialChip.astro";
import productores from "../data/productores.json";

// Los makers que ya están dados de alta. Somos pocos y se dice: es más
// honesto que una cuadrícula de caras de archivo.
const makers = productores.slice(0, 3);

const pasos = [
  {
    titulo: "Cuéntanos la pieza",
    texto:
      "Descríbela como se la contarías a un amigo. Si tienes fotos, un boceto o un archivo STL, súbelo; si solo tienes la idea, también vale.",
    nota: "5 minutos",
  },
  {
    titulo: "Apruebas el boceto",
    texto:
      "Un diseñador convierte tu descripción en un modelo y te lo enseña antes de gastar un gramo de filamento. Se cambia hasta que encaje.",
    nota: "Nada se imprime sin tu visto bueno",
  },
  {
    titulo: "Un maker cercano la imprime",
    texto:
      "El encargo va a alguien de tu zona con la máquina adecuada. Ves fotos del proceso y recibes la pieza terminada.",
    nota: "Seguimiento con fotos",
  },
];

const encargos = [
  {
    titulo: "Un repuesto que ya no se fabrica",
    texto:
      "La rueda del carro de la compra, el enganche del toldo, la tapa del mando que se rompió.",
    material: "PETG",
  },
  {
    titulo: "Una figura o una miniatura",
    texto:
      "Personajes de rol, maquetas, trofeos, regalos con el nombre de alguien encima.",
    material: "Resina",
  },
  {
    titulo: "Algo a medida para casa",
    texto:
      "Soportes, organizadores y adaptadores que no existen en ninguna tienda porque tu hueco mide lo que mide.",
    material: "PLA",
  },
  {
    titulo: "Un prototipo de tu proyecto",
    texto:
      "Tener la idea en la mano antes de encargar un molde o una serie. Se corrige y se vuelve a imprimir.",
    material: "PLA",
  },
];

const materiales = [
  {
    codigo: "PLA",
    color: "var(--mat-pla)",
    que: "Rígido, económico y el más habitual.",
    para: "Decoración, figuras, prototipos",
  },
  {
    codigo: "PETG",
    color: "var(--mat-petg)",
    que: "Aguanta golpes, calor y humedad.",
    para: "Repuestos y piezas de exterior",
  },
  {
    codigo: "Resina",
    color: "var(--mat-resina)",
    que: "Detalle finísimo y superficie lisa.",
    para: "Miniaturas, joyería, maquetas",
  },
  {
    codigo: "TPU",
    color: "var(--mat-tpu)",
    que: "Flexible, como una goma dura.",
    para: "Fundas, juntas y topes",
  },
];
---

<BaseLayout>
  <main>
    <section class="portada">
      <div class="envoltura portada__interior">
        <div class="portada__texto">
          <p class="etiqueta etiqueta--marca">Impresión 3D por encargo</p>
          <h1 class="portada__titular">
            Cuéntalo con tus palabras. Sale impreso en tu ciudad.
          </h1>
          <p class="entradilla portada__entrada">
            No hace falta que sepas qué es un STL ni que tengas impresora.
            Describes la pieza, un diseñador te manda un boceto y, cuando lo
            apruebas, un maker cercano la fabrica.
          </p>
          <div class="portada__acciones">
            <a href="/briefing" class="boton boton--principal">
              Pedir una pieza <span class="boton__flecha" aria-hidden="true">→</span>
            </a>
            <a href="/productores" class="boton boton--secundario">Ver makers</a>
          </div>
          <ul class="portada__garantias dato">
            <li>Boceto antes de imprimir</li>
            <li>Makers verificados</li>
            <li>Sin compromiso hasta aprobarlo</li>
          </ul>
        </div>

        <div class="portada__pieza">
          <PiezaEnCapas />
        </div>
      </div>
    </section>

    <section class="seccion proceso" id="como-funciona">
      <div class="envoltura">
        <div class="rotulo">
          <p class="etiqueta">Cómo funciona</p>
          <h2>Del recado a la pieza, en tres pasos</h2>
        </div>

        <ol class="proceso__lista">
          {
            pasos.map((paso, indice) => (
              <li class="paso">
                <span class="paso__indice dato" aria-hidden="true">
                  {String(indice + 1).padStart(2, "0")}
                </span>
                <div class="paso__cuerpo">
                  <h3 class="paso__titulo">{paso.titulo}</h3>
                  <p class="paso__texto">{paso.texto}</p>
                  <p class="paso__nota dato">{paso.nota}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="seccion encargos">
      <div class="envoltura">
        <div class="rotulo rotulo--partido">
          <div>
            <p class="etiqueta">Qué se pide aquí</p>
            <h2>Casi siempre es una de estas cuatro cosas</h2>
          </div>
          <p class="entradilla rotulo__apunte">
            Si lo tuyo no aparece en la lista, cuéntalo igual. Lo raro se
            imprime igual de bien.
          </p>
        </div>

        <ul class="encargos__lista">
          {
            encargos.map((encargo) => (
              <li class="encargo">
                <h3 class="encargo__titulo">{encargo.titulo}</h3>
                <p class="encargo__texto">{encargo.texto}</p>
                <p class="encargo__material dato">
                  Suele hacerse en {encargo.material}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="seccion materiales">
      <div class="envoltura materiales__interior">
        <div class="rotulo">
          <p class="etiqueta">Materiales</p>
          <h2>En qué se puede imprimir</h2>
          <p class="entradilla materiales__apunte">
            Elegir material es cosa del maker. Esto es solo para que sepas de
            qué te habla cuando lo mencione.
          </p>
        </div>

        <table class="tabla-materiales">
          <thead>
            <tr>
              <th scope="col">Material</th>
              <th scope="col">Qué es</th>
              <th scope="col">Va bien para</th>
            </tr>
          </thead>
          <tbody>
            {
              materiales.map((material) => (
                <tr>
                  <th scope="row">
                    <span
                      class="tabla-materiales__punto"
                      style={`background:${material.color}`}
                    />
                    {material.codigo}
                  </th>
                  <td>{material.que}</td>
                  <td class="tabla-materiales__uso">{material.para}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="seccion quienes">
      <div class="envoltura">
        <div class="rotulo rotulo--partido">
          <div>
            <p class="etiqueta">Quién imprime</p>
            <h2>Detrás de cada pieza hay alguien con su máquina</h2>
          </div>
          <p class="entradilla rotulo__apunte">
            Acabamos de empezar, así que de momento somos pocos y salimos con
            nombre y apellidos. Puedes ver el taller de cada uno antes de
            encargar nada.
          </p>
        </div>

        <ul class="quienes__lista">
          {
            makers.map((maker) => (
              <li class="taller-maker">
                <img
                  class="taller-maker__foto"
                  src={maker.foto}
                  alt=""
                  width="88"
                  height="88"
                  loading="lazy"
                />
                <div>
                  <h3 class="taller-maker__nombre">
                    <a href={`/productores/${maker.slug}`}>{maker.nombre}</a>
                  </h3>
                  <p class="taller-maker__sitio dato">{maker.ubicacion}</p>
                  <p class="taller-maker__bio">{maker.bio}</p>
                  <div class="taller-maker__chips">
                    {maker.materiales.map((codigo) => (
                      <MaterialChip codigo={codigo} />
                    ))}
                  </div>
                  <p class="taller-maker__equipo dato">
                    {maker.impresoras.join(" · ")}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>

        <a href="/productores" class="quienes__enlace">
          Ver el directorio de makers
          <span class="boton__flecha" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="en-cianotipo llamada-maker">
      <div class="envoltura llamada-maker__interior">
        <div>
          <p class="etiqueta">Para makers</p>
          <h2 class="llamada-maker__titulo">
            ¿Tienes una impresora parada media semana?
          </h2>
          <p class="llamada-maker__texto">
            Te llegan encargos de tu provincia y decides cuáles coges. Sin cuota
            mensual: solo una comisión cuando entregas la pieza.
          </p>
          <ul class="llamada-maker__puntos dato">
            <li>Sin cuota mensual</li>
            <li>Tú eliges los pedidos</li>
            <li>Encargos de tu zona</li>
          </ul>
        </div>
        <a href="/maker" class="boton boton--claro llamada-maker__accion">
          Darme de alta <span class="boton__flecha" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* --- Portada -------------------------------------------------------- */

  .portada {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--linea);
  }

  .portada::before {
    content: "";
    position: absolute;
    inset: 0 0 0 55%;
    border-left: 1px solid var(--linea);
    background-image: linear-gradient(var(--linea) 1px, transparent 1px),
      linear-gradient(90deg, var(--linea) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.46;
    pointer-events: none;
  }

  .portada__interior {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(24rem, 1.08fr);
    align-items: center;
    gap: clamp(2.5rem, 1rem + 4.5vw, 5.5rem);
    min-height: clamp(40rem, calc(100svh - 67px), 47rem);
    padding-block: clamp(3.5rem, 2rem + 5vw, 6rem);
  }

  .portada__texto {
    position: relative;
    z-index: 1;
  }

  .portada__titular {
    margin-top: 1.1rem;
    max-width: 14ch;
    font-size: clamp(3rem, 4.15vw, 4.35rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .portada__entrada {
    margin-top: 1.6rem;
    max-width: 47ch;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.2rem;
  }

  .portada__garantias {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 1.2rem;
    margin-top: 2.4rem;
    counter-reset: garantia;
    color: var(--tinta-suave);
  }

  .portada__garantias li {
    padding-top: 0.7rem;
    border-top: 1px solid var(--linea);
    counter-increment: garantia;
    line-height: 1.45;
  }

  .portada__garantias li::before {
    content: "0" counter(garantia);
    display: block;
    margin-bottom: 0.35rem;
    color: var(--filamento-tinta);
    font-weight: 600;
  }

  .portada__pieza {
    position: relative;
    z-index: 1;
    justify-self: end;
    width: min(100%, 43rem);
  }

  .portada__pieza::before {
    content: "";
    position: absolute;
    inset: 7% -3% 14% 8%;
    z-index: -1;
    border: 1px solid var(--linea-fuerte);
    border-left: 3px solid var(--filamento);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .portada__texto > * {
      animation: entrar-portada 540ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .portada__texto > :nth-child(2) {
      animation-delay: 70ms;
    }

    .portada__texto > :nth-child(3) {
      animation-delay: 130ms;
    }

    .portada__texto > :nth-child(4) {
      animation-delay: 190ms;
    }

    .portada__texto > :nth-child(5) {
      animation-delay: 250ms;
    }

    .portada__pieza {
      animation: entrar-pieza 680ms 120ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }

  @keyframes entrar-portada {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes entrar-pieza {
    from {
      opacity: 0;
      transform: translate3d(18px, 10px, 0) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @media (max-width: 940px) {
    .portada::before {
      inset: 56% 0 0;
      border-top: 1px solid var(--linea);
      border-left: 0;
      opacity: 0.34;
    }

    .portada__interior {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.6rem;
      min-height: 0;
      padding-block: clamp(2.75rem, 1.5rem + 6vw, 4.25rem);
    }

    .portada__texto {
      display: contents;
    }

    .portada__texto > .etiqueta {
      grid-row: 1;
    }

    .portada__titular {
      grid-row: 2;
      margin-top: -0.65rem;
      max-width: 15ch;
      font-size: clamp(3.25rem, 8vw, 4.35rem);
    }

    .portada__entrada {
      grid-row: 3;
      margin-top: -0.5rem;
    }

    .portada__acciones {
      grid-row: 4;
      margin-top: 0;
    }

    .portada__pieza {
      grid-row: 5;
      justify-self: center;
      width: min(100%, 36rem);
    }

    .portada__garantias {
      grid-row: 6;
      margin-top: 0.25rem;
    }
  }

  @media (max-width: 480px) {
    .portada__titular {
      max-width: 12ch;
      font-size: clamp(2.55rem, 12vw, 3.15rem);
    }

    .portada__acciones {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    }

    .portada__acciones .boton {
      justify-content: center;
      padding-inline: 0.85rem;
    }

    .portada__pieza::before {
      inset: 7% 0 14% 6%;
    }

    .portada__garantias {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .portada__garantias li {
      display: grid;
      grid-template-columns: 2.25rem minmax(0, 1fr);
      align-items: baseline;
      padding-block: 0.7rem;
    }

    .portada__garantias li::before {
      margin: 0;
    }
  }

  /* --- Rótulos de sección --------------------------------------------- */

  .rotulo {
    margin-bottom: clamp(2rem, 1.2rem + 2.4vw, 3.25rem);
  }

  .rotulo h2 {
    margin-top: 0.75rem;
    max-width: 20ch;
  }

  .rotulo--partido {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    align-items: end;
    gap: 1.5rem 3rem;
  }

  .rotulo__apunte {
    font-size: var(--paso-0);
  }

  @media (max-width: 780px) {
    .rotulo--partido {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* --- Proceso: la línea es el recorrido del filamento ---------------- */

  .proceso {
    background: var(--pieza);
    border-bottom: 1px solid var(--linea);
  }

  .proceso__lista {
    display: grid;
    gap: 0;
  }

  .paso {
    --pad: 1.75rem;
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 0 1.75rem;
    padding-block: var(--pad);
    border-top: 1px solid var(--linea);
  }

  .paso:last-child {
    border-bottom: 1px solid var(--linea);
  }

  /* El hilo continuo que enhebra los tres pasos: el recorrido que hace el
     encargo desde que lo cuentas hasta que lo tienes en la mano. */
  .paso::before {
    content: "";
    position: absolute;
    left: 0.42rem;
    top: calc(var(--pad) + 1.8rem);
    bottom: calc((var(--pad) + 0.1rem) * -1);
    width: 2px;
    background: var(--filamento);
    opacity: 0.42;
  }

  .paso:last-child::before {
    display: none;
  }

  .paso__indice {
    padding-top: 0.28rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--filamento-tinta);
  }

  .paso__texto {
    margin-top: 0.5rem;
    max-width: 58ch;
    color: var(--tinta-media);
  }

  .paso__nota {
    margin-top: 0.85rem;
    color: var(--tinta-suave);
  }

  @media (min-width: 900px) {
    .proceso__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid var(--linea);
      border-bottom: 1px solid var(--linea);
    }

    .paso {
      --pad: 2rem;
      display: block;
      min-height: 20rem;
      padding: var(--pad) clamp(1.5rem, 2.4vw, 2.5rem) 2.25rem;
      border: 0;
    }

    .paso + .paso {
      border-left: 1px solid var(--linea);
    }

    .paso::before {
      left: 0;
      top: -1px;
      bottom: auto;
      width: 3.5rem;
      height: 2px;
      opacity: 1;
    }

    .paso:last-child::before {
      display: block;
    }

    .paso__indice {
      display: block;
      margin-bottom: clamp(2.75rem, 4vw, 4.25rem);
      padding: 0;
      font-size: var(--paso-2);
      line-height: 1;
    }

    .paso__cuerpo {
      display: block;
    }

    .paso__texto {
      margin-top: 0.8rem;
    }

    .paso__nota {
      margin-top: 1.2rem;
    }
  }

  @media (max-width: 560px) {
    .paso {
      grid-template-columns: 2.4rem minmax(0, 1fr);
      gap: 0 1rem;
    }
  }

  /* --- Qué se pide ----------------------------------------------------- */

  .encargos {
    border-bottom: 1px solid var(--linea);
  }

  .encargos__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 2px solid var(--tinta);
    counter-reset: encargo;
  }

  .encargo {
    position: relative;
    min-height: 13.5rem;
    padding: clamp(1.75rem, 2.8vw, 2.75rem) clamp(1.5rem, 3.2vw, 3.25rem)
      clamp(1.75rem, 2.8vw, 2.75rem) clamp(3.5rem, 5vw, 5rem);
    counter-increment: encargo;
  }

  .encargo::before {
    content: "0" counter(encargo);
    position: absolute;
    top: clamp(1.9rem, 3vw, 2.9rem);
    left: clamp(0.25rem, 1.2vw, 1rem);
    color: var(--filamento-tinta);
    font-family: var(--fuente-dato);
    font-size: 0.74rem;
    font-weight: 600;
  }

  .encargo:nth-child(even) {
    border-left: 1px solid var(--linea);
  }

  .encargo:nth-child(n + 3) {
    border-top: 1px solid var(--linea);
  }

  .encargo__titulo {
    font-size: var(--paso-1);
    font-stretch: 108%;
    font-weight: 700;
    max-width: 23ch;
  }

  .encargo__texto {
    margin-top: 0.8rem;
    max-width: 42ch;
    font-size: 0.96rem;
    line-height: 1.58;
    color: var(--tinta-media);
  }

  .encargo__material {
    margin-top: 1.1rem;
    color: var(--tinta-suave);
  }

  @media (max-width: 699px) {
    .encargos__lista {
      grid-template-columns: minmax(0, 1fr);
    }

    .encargo {
      min-height: 0;
      padding: 1.5rem 0 1.6rem 2.75rem;
      border-top: 1px solid var(--linea);
    }

    .encargo:first-child {
      border-top: 0;
    }

    .encargo:nth-child(even) {
      border-left: 0;
    }

    .encargo::before {
      top: 1.65rem;
      left: 0;
    }
  }

  /* --- Materiales ------------------------------------------------------ */

  .materiales {
    background: var(--pieza);
    border-bottom: 1px solid var(--linea);
  }

  .materiales__interior {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    align-items: start;
  }

  .materiales .rotulo {
    margin-bottom: 0;
  }

  .materiales__apunte {
    margin-top: 1rem;
    font-size: 0.95rem;
  }

  .tabla-materiales {
    width: 100%;
    text-align: left;
  }

  .tabla-materiales th,
  .tabla-materiales td {
    padding: 0.9rem 1rem 0.9rem 0;
    border-bottom: 1px solid var(--linea);
    vertical-align: baseline;
  }

  .tabla-materiales thead th {
    padding-top: 0;
    border-bottom-color: var(--tinta);
    border-bottom-width: 2px;
    font-family: var(--fuente-dato);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  .tabla-materiales tbody th {
    font-family: var(--fuente-dato);
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .tabla-materiales__punto {
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 0.5rem;
    border-radius: 2px;
    vertical-align: baseline;
  }

  .tabla-materiales td {
    font-size: 0.94rem;
    color: var(--tinta-media);
  }

  .tabla-materiales__uso {
    color: var(--tinta-suave);
  }

  @media (max-width: 880px) {
    .materiales__interior {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 620px) {
    .tabla-materiales thead {
      display: none;
    }

    .tabla-materiales tr {
      display: block;
      padding-block: 1rem;
      border-bottom: 1px solid var(--linea);
    }

    .tabla-materiales th,
