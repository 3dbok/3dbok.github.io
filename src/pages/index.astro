</style>

<script>
  // --- Recorrido: el scroll mueve los tres pasos -------------------------
  const recorrido = document.querySelector("[data-recorrido]");

  if (recorrido) {
    const pasos = [...recorrido.querySelectorAll("[data-paso-indice]")];
    const tecleo = recorrido.querySelector("[data-tecleo]");
    const frase = tecleo?.dataset.frase ?? "";
    const capas = [...recorrido.querySelectorAll("[data-rueda-capa]")];
    const titulo = recorrido.querySelector(".recorrido__titulo");
    const acotar = (valor) => Math.min(1, Math.max(0, valor));
    let pendiente = false;
    let capasPuestas = -1;

    recorrido.classList.add("esta-guiada");

    const medirTitulo = () => {
      if (titulo) recorrido.style.setProperty("--alto-titulo", `${titulo.offsetHeight}px`);
    };

    const actualizar = () => {
      pendiente = false;
      const caja = recorrido.getBoundingClientRect();
      const fijo = recorrido.querySelector(".recorrido__fijo");
      const distancia = caja.height - (fijo?.offsetHeight ?? window.innerHeight);
      const p = acotar(-caja.top / Math.max(distancia, 1));
      const paso = Math.min(2, Math.floor(p * 3));
      // Cada escena se completa un poco antes de ceder el sitio a la siguiente.
      const local = [0, 1, 2].map((i) => acotar((p * 3 - i) * 1.3));

      recorrido.style.setProperty("--p", p.toFixed(4));
      recorrido.style.setProperty("--p2", local[1].toFixed(4));
      recorrido.dataset.paso = String(paso);
      pasos.forEach((li, i) => {
        if (i === paso) li.setAttribute("aria-current", "step");
        else li.removeAttribute("aria-current");
      });

      if (tecleo) tecleo.textContent = frase.slice(0, Math.round(frase.length * acotar(local[0] * 1.2)));
      recorrido.classList.toggle("con-adjuntos", local[0] > 0.86);
      recorrido.classList.toggle("con-envio", local[0] >= 1);
      recorrido.classList.toggle("con-sello", local[1] >= 0.95);
      recorrido.classList.toggle("con-entrega", local[2] >= 1);

      const puestas = Math.round(capas.length * local[2]);
      if (puestas !== capasPuestas) {
        capas.forEach((capa, i) => {
          capa.classList.toggle("esta-puesta", i < puestas);
          // La cara de arriba siempre es la última capa puesta; justo debajo,
          // un par de capas calientes marcan por dónde va la boquilla.
          const enCurso = puestas < capas.length;
          capa.classList.toggle("es-tapa", i === puestas - 1);
          capa.classList.toggle("esta-caliente", enCurso && i >= puestas - 3 && i < puestas - 1);
        });
        capasPuestas = puestas;
      }
    };

    const pedir = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(actualizar);
    };

    medirTitulo();
    actualizar();
    window.addEventListener("scroll", pedir, { passive: true });
    window.addEventListener("resize", () => {
      medirTitulo();
      pedir();
    });
  }

  // --- Materiales: pestañas accesibles ------------------------------------
  const seccion = document.querySelector("[data-materiales]");

  if (seccion) {
    const lista = seccion.querySelector("[role='tablist']");
    const pestanas = [...seccion.querySelectorAll("[role='tab']")];
    const paneles = [...seccion.querySelectorAll("[role='tabpanel']")];
    const muestra = seccion.querySelector("[data-muestra]");

    const elegir = (pestana, enfocar = false) => {
      const id = pestana.dataset.material;
      pestanas.forEach((otra) => {
        const activa = otra === pestana;
        otra.setAttribute("aria-selected", String(activa));
        otra.tabIndex = activa ? 0 : -1;
      });
      paneles.forEach((panel) => {
        const activo = panel.dataset.panel === id;
        panel.hidden = !activo;
        panel.classList.remove("esta-entrando");
        if (activo) {
          void panel.offsetWidth;
          panel.classList.add("esta-entrando");
        }
      });
      if (muestra) {
        muestra.dataset.muestra = id;
        muestra.classList.remove("esta-cambiando");
        void muestra.getBoundingClientRect();
        muestra.classList.add("esta-cambiando");
      }
      if (enfocar) pestana.focus();
    };

    if (lista) lista.hidden = false;
    seccion.classList.add("esta-activa");
    paneles.forEach((panel, i) => (panel.hidden = i !== 0));

    pestanas.forEach((pestana, i) => {
      pestana.addEventListener("click", () => elegir(pestana));
      pestana.addEventListener("keydown", (evento) => {
        const mover = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[evento.key];
        if (mover) {
          evento.preventDefault();
          elegir(pestanas[(i + mover + pestanas.length) % pestanas.length], true);
        } else if (evento.key === "Home") {
          evento.preventDefault();
          elegir(pestanas[0], true);
        } else if (evento.key === "End") {
          evento.preventDefault();
          elegir(pestanas[pestanas.length - 1], true);
        }
      });
    });
  }
</script>
