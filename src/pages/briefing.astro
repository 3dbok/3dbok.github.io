---
import BaseLayout from "../layouts/BaseLayout.astro";
import productores from "../data/productores.json";
import {
  MATERIALES_PEDIDO,
  PASOS_PEDIDO,
  PRESUPUESTOS_PEDIDO,
  TAMANOS_PEDIDO,
} from "../lib/pedidoShared.js";

const FORMSPREE_PEDIDOS_ENDPOINT =
  import.meta.env.PUBLIC_FORMSPREE_PEDIDOS_ENDPOINT ?? "https://formspree.io/f/xpqgngdj";
---

<BaseLayout
  title="Pedir una pieza"
  descripcion="Describe la pieza que necesitas en cinco pasos. Revisaremos tu solicitud antes de que nadie empiece a diseñar o imprimir."
>
  <main class="brief">
    <form
      class="envoltura--angosta"
      data-order-form
      data-endpoint={FORMSPREE_PEDIDOS_ENDPOINT}
      novalidate
    >
      <button class="brief__volver dato" data-back type="button">
        ← Volver al inicio
      </button>

      <div class="brief__avance">
        <div class="brief__avance-datos dato">
          <span>Paso <span data-step-current>1</span> de {PASOS_PEDIDO.length}</span>
          <span><span data-progress-text>0</span> % completado</span>
        </div>
        <div
          class="brief__barra"
          role="progressbar"
          aria-label="Progreso del pedido"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          data-progress-bar
        >
          <div class="brief__barra-relleno" data-progress-fill></div>
        </div>
      </div>

      <p class="brief__elegido" data-selected-product hidden></p>
      <p class="brief__recuperado dato" data-draft-notice role="status" hidden></p>

      <h1 class="brief__titulo" data-step-title tabindex="-1">
        {PASOS_PEDIDO[0].titulo}
      </h1>

      <section data-step="0">
        <p class="brief__ayuda" id="description-help">
          Escríbelo como se lo contarías a un amigo. Cuanto más detalle nos des,
          menos vueltas dará la propuesta.
        </p>
        <label class="solo-lectores" for="brief-descripcion">Describe la pieza</label>
        <textarea
          class="entrada"
          id="brief-descripcion"
          data-field="description"
          rows="7"
          required
          minlength="15"
          maxlength="2000"
          aria-describedby="description-help description-count"
          placeholder="Por ejemplo: quiero una miniatura de un dragón negro de unos 10 cm, con las alas desplegadas y postura amenazante. Es para mi partida de rol y quiero que imponga…"
        ></textarea>
        <p class="brief__contador dato" id="description-count" data-description-count>
          0 de 2000 caracteres · mínimo 15
        </p>
      </section>

      <section data-step="1" hidden>
        <p class="brief__ayuda" id="design-help">
          Si tienes un STL, puedes previsualizarlo aquí. El archivo no se envía
          ni se guarda: si lo seleccionas, te lo pediremos después por email.
        </p>
        <fieldset class="brief__grupo" data-choice-group="hasDesign" aria-describedby="design-help">
          <legend class="solo-lectores">Estado del diseño</legend>
          <div class="brief__opciones">
            {
              [
                {
                  valor: false,
                  etiqueta: "Solo tengo la idea",
                  nota: "Te ayudaremos a concretar el diseño antes de imprimir",
                },
                {
                  valor: true,
                  etiqueta: "Ya tengo el diseño",
                  nota: "Puedes comprobar el STL aquí; te lo pediremos por email",
                },
              ].map((opcion) => (
                <button
                  class="opcion"
                  type="button"
                  data-choice="hasDesign"
                  data-value={String(opcion.valor)}
                  aria-pressed="false"
                >
                  <span class="opcion__titulo">{opcion.etiqueta}</span>
                  <span class="opcion__nota">{opcion.nota}</span>
                </button>
              ))
            }
          </div>
        </fieldset>

        <div class="brief__subida" data-design-upload hidden>
          <input data-design-file type="file" accept=".stl" hidden />
          <button class="brief__soltar" type="button" data-design-upload-button>
            <span class="brief__soltar-titulo">Elegir STL para previsualizar</span>
            <span class="brief__soltar-nota dato">No se sube ni se guarda</span>
          </button>
          <div class="brief__archivo-acciones" data-design-file-actions hidden>
            <p class="brief__archivo-estado dato" data-design-file-status role="status" aria-live="polite"></p>
            <button class="brief__quitar dato" type="button" data-design-remove>
              Quitar archivo
            </button>
          </div>
          <div class="brief__vista" data-stl-preview hidden>
            <div class="brief__lienzo" data-stl-container></div>
            <p class="brief__ayuda-corta dato" data-stl-message aria-live="polite">
              Arrastra para girar la pieza, rueda para acercar.
            </p>
          </div>
        </div>
      </section>

      <section data-step="2" hidden>
        <p class="brief__ayuda" id="size-help">
          Con una referencia aproximada basta. Ajustaremos las medidas exactas
          contigo antes de producir la pieza.
        </p>
        <fieldset class="brief__grupo" data-choice-group="size" aria-describedby="size-help">
          <legend class="solo-lectores">Tamaño aproximado</legend>
          <div class="brief__rejilla">
            {
              TAMANOS_PEDIDO.map((tamano) => (
                <button
                  class="opcion"
                  type="button"
                  data-choice="size"
                  data-value={tamano.id}
                  aria-pressed="false"
                >
                  <span class="opcion__titulo">{tamano.etiqueta}</span>
                  <span class="opcion__nota">{tamano.nota}</span>
                  <span class="opcion__medida">{tamano.medida}</span>
                </button>
              ))
            }
          </div>
        </fieldset>
      </section>

      <section data-step="3" hidden>
        <div class="brief__campos">
          <div class="campo">
            <label class="campo__nombre" for="brief-maker">Quién lo imprime</label>
            <p class="campo__ayuda" id="maker-help">
              Puedes elegir un maker concreto o dejar que te propongamos el más
              adecuado para tu pieza.
            </p>
            <select
              class="entrada"
              id="brief-maker"
              data-field="makerId"
              aria-describedby="maker-help"
            >
              <option value="recommended">Que 3dbok elija por mí</option>
              {
                productores.map((productor) => (
                  <option
                    value={productor.id}
                    data-slug={productor.slug}
                    data-products={JSON.stringify(
                      productor.productos.map(({ id, nombre }) => ({ id, nombre })),
                    )}
                  >
                    {productor.nombre} — {productor.ubicacion}
                  </option>
                ))
              }
            </select>
          </div>

          <fieldset class="brief__grupo campo" data-choice-group="material">
            <legend class="campo__nombre">Material</legend>
            <div class="brief__rejilla">
              {
                MATERIALES_PEDIDO.map((material) => (
                  <button
                    class="opcion"
                    type="button"
                    data-choice="material"
                    data-value={material.id}
                    aria-pressed="false"
                  >
                    <span class="opcion__titulo">{material.etiqueta}</span>
                    <span class="opcion__nota">{material.nota}</span>
                  </button>
                ))
              }
            </div>
          </fieldset>

          <div class="campo">
            <label class="campo__nombre" for="brief-color">Color</label>
            <p class="campo__ayuda" id="color-help">
              Descríbelo con tus palabras. Si te da igual, déjalo en blanco.
            </p>
            <input
              class="entrada"
              id="brief-color"
              data-field="color"
              type="text"
              maxlength="100"
              aria-describedby="color-help"
              placeholder="Negro mate, rojo sangre, madera natural…"
            />
          </div>

          <div class="campo">
            <label class="campo__nombre" for="brief-fecha">Para cuándo lo necesitas</label>
            <p class="campo__ayuda" id="deadline-help">La fecha más próxima es dentro de 7 días.</p>
            <input
              class="entrada"
              id="brief-fecha"
              data-field="deadline"
              type="date"
              aria-describedby="deadline-help"
            />
          </div>

          <fieldset class="brief__grupo campo" data-choice-group="budget">
            <legend class="campo__nombre">Presupuesto aproximado</legend>
            <p class="campo__ayuda" id="budget-help">
              Solo nos orienta. No es un compromiso ni un precio final.
            </p>
            <div class="fila-opciones" aria-describedby="budget-help">
              {
                PRESUPUESTOS_PEDIDO.map((presupuesto) => (
                  <button
                    class="opcion opcion--pastilla"
                    type="button"
                    data-choice="budget"
                    data-value={presupuesto}
                    aria-pressed="false"
                  >
                    {presupuesto}
                  </button>
                ))
              }
            </div>
          </fieldset>
        </div>
      </section>

      <section data-step="4" hidden>
        <p class="brief__ayuda">
          Usaremos estos datos para responder a la solicitud y coordinar los
          siguientes pasos contigo.
        </p>
        <div class="brief__campos">
          <div class="campo">
            <label class="campo__nombre" for="brief-nombre">Nombre</label>
            <input
              class="entrada"
              id="brief-nombre"
              data-field="name"
              type="text"
              autocomplete="name"
              required
              minlength="2"
              maxlength="100"
              placeholder="Tu nombre"
            />
          </div>
          <div class="campo">
            <label class="campo__nombre" for="brief-email">Email</label>
            <input
              class="entrada"
              id="brief-email"
              data-field="email"
              type="email"
              autocomplete="email"
              required
              maxlength="254"
              inputmode="email"
              placeholder="tu@email.com"
            />
          </div>
          <div class="campo">
            <label class="campo__nombre" for="brief-tel">
              Teléfono <span class="campo__opcional">(opcional)</span>
            </label>
            <input
              class="entrada"
              id="brief-tel"
              data-field="phone"
              type="tel"
              autocomplete="tel"
              maxlength="30"
              placeholder="+34 600 000 000"
            />
          </div>
        </div>

        <p class="brief__privacidad">
          Trataremos los datos para responder a tu solicitud. Formspree procesa
          el formulario por cuenta de 3dbok y podremos compartir la información
          necesaria con el diseñador o maker que la valore. Consulta la
          <a href="/privacidad">política de privacidad</a>.
        </p>
      </section>

      <p class="brief__error" data-form-error role="alert" tabindex="-1" hidden></p>

      <div class="brief__pie">
        <p class="brief__nota dato" data-footer-note>
          Sin compromiso hasta que apruebes la propuesta
        </p>
        <button class="boton boton--principal" data-next type="submit">
          Continuar <span class="boton__flecha" aria-hidden="true">→</span>
        </button>
      </div>
    </form>
  </main>
</BaseLayout>

<style>
  .brief {
    padding-block: clamp(1.75rem, 1rem + 2.5vw, 3rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .brief__volver {
    padding: 0;
    border: 0;
    background: none;
    color: var(--tinta-suave);
    cursor: pointer;
  }

  .brief__volver:hover,
  .brief__quitar:hover {
    color: var(--tinta);
    text-decoration: underline;
  }

  .brief__avance {
    margin-top: 2rem;
  }

  .brief__avance-datos {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
    color: var(--tinta-suave);
  }

  .brief__barra {
    height: 3px;
    background: var(--bancada-honda);
    overflow: hidden;
  }

  .brief__barra-relleno {
    height: 100%;
    width: 0;
    background: var(--filamento);
    transition: width 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .brief__titulo {
    margin-top: 1.75rem;
    margin-bottom: 1.5rem;
    font-size: var(--paso-3);
  }

  .brief__titulo:focus {
    outline: none;
  }

  .brief__ayuda {
    margin-bottom: 1.25rem;
    color: var(--tinta-media);
    line-height: 1.6;
  }

  .brief__contador {
    margin-top: 0.55rem;
    color: var(--tinta-suave);
  }

  .brief__contador[data-completo] {
    color: var(--verde);
  }

  .brief__grupo {
    min-inline-size: 0;
    padding: 0;
    margin: 0;
    border: 0;
  }

  .brief__grupo[aria-invalid="true"] .opcion,
  .entrada[aria-invalid="true"] {
    border-color: var(--alerta);
  }

  .brief__opciones {
    display: grid;
    gap: 0.65rem;
  }

  .brief__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    gap: 0.65rem;
  }

  .brief__campos {
    display: grid;
    gap: 1.6rem;
  }

  .campo__opcional {
    color: var(--tinta-suave);
    font-weight: 400;
  }

  .brief__elegido,
  .brief__recuperado {
    padding: 0.75rem 1rem;
    margin-top: 1.25rem;
    border-left: 3px solid var(--filamento);
    background: var(--pieza);
    font-size: 0.93rem;
  }

  .brief__recuperado {
    border-left-color: var(--cianotipo);
    color: var(--tinta-media);
  }

  .brief__subida {
    margin-top: 1.25rem;
  }

  .brief__soltar {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
    padding: 1.4rem 1.25rem;
    border: 1px dashed var(--linea-fuerte);
    border-radius: var(--r-2);
    background: var(--pieza);
    cursor: pointer;
    text-align: center;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }

  .brief__soltar:hover {
    border-color: var(--cianotipo);
    background: var(--cianotipo-lavado);
  }

  .brief__soltar-titulo {
    font-weight: 600;
  }

  .brief__soltar-nota,
  .brief__archivo-estado {
    color: var(--tinta-suave);
  }

  .brief__soltar[data-cargado] {
    border-style: solid;
    border-color: var(--verde);
  }

  .brief__archivo-acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.65rem;
  }

  .brief__quitar {
    padding: 0;
    border: 0;
    background: none;
    color: var(--tinta-suave);
    cursor: pointer;
  }

  .brief__vista {
    margin-top: 0.9rem;
  }

  .brief__lienzo {
    height: 300px;
    border: 1px solid var(--linea);
    border-radius: var(--r-2);
    background: var(--bancada-honda);
    overflow: hidden;
  }

  .brief__ayuda-corta {
    margin-top: 0.5rem;
    color: var(--tinta-suave);
  }

  .brief__ayuda-corta[data-error],
  .brief__error {
    color: var(--alerta);
  }

  .brief__privacidad {
    margin-top: 1.5rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--linea);
    border-radius: var(--r-2);
    background: var(--pieza);
    font-size: 0.88rem;
    color: var(--tinta-suave);
    line-height: 1.55;
  }

  .brief__error {
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    border-left: 3px solid var(--alerta);
    background: var(--pieza);
    line-height: 1.5;
  }

  .brief__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--linea);
  }

  .brief__nota {
    color: var(--tinta-suave);
  }

  @media (max-width: 480px) {
    .brief__pie {
      flex-direction: column-reverse;
      align-items: stretch;
    }

    .brief__pie .boton {
      justify-content: center;
    }

    .brief__nota {
      text-align: center;
    }
  }
</style>

<script>
  import {
    BORRADOR_TTL_MS,
    MATERIALES_PEDIDO,
    MAX_STL_PREVIEW_BYTES,
    PASOS_PEDIDO,
    PEDIDO_BORRADOR_STORAGE_KEY,
    PEDIDO_CONFIRMACION_STORAGE_KEY,
    PRESUPUESTOS_PEDIDO,
    TAMANOS_PEDIDO,
    crearIdentidadPedido,
  } from "../lib/pedidoShared.js";

  let paso = 0;
  let enviando = false;
  let descartarVista = null;
  let origenMakerSlug = "";

  const pedido = {
    description: "",
    hasDesign: null,
    designFileName: "",
    designFileSize: 0,
    designFileObject: null,
    size: "",
    color: "",
    material: "any",
    deadline: "",
    budget: "",
    name: "",
    email: "",
    phone: "",
    makerId: "recommended",
    productId: "",
    productName: "",
    requestId: "",
    orderId: "",
  };

  const formulario = document.querySelector("[data-order-form]");
  const secciones = Array.from(document.querySelectorAll("[data-step]"));
  const botonAtras = document.querySelector("[data-back]");
  const botonSiguiente = document.querySelector("[data-next]");
  const tituloPaso = document.querySelector("[data-step-title]");
  const pasoActual = document.querySelector("[data-step-current]");
  const textoAvance = document.querySelector("[data-progress-text]");
  const barraAvance = document.querySelector("[data-progress-bar]");
  const rellenoAvance = document.querySelector("[data-progress-fill]");
  const notaPie = document.querySelector("[data-footer-note]");
  const errorFormulario = document.querySelector("[data-form-error]");
  const avisoBorrador = document.querySelector("[data-draft-notice]");
  const zonaSubida = document.querySelector("[data-design-upload]");
  const entradaArchivo = document.querySelector("[data-design-file]");
  const botonSubir = document.querySelector("[data-design-upload-button]");
  const accionesArchivo = document.querySelector("[data-design-file-actions]");
  const estadoArchivo = document.querySelector("[data-design-file-status]");
  const botonQuitarArchivo = document.querySelector("[data-design-remove]");
  const contador = document.querySelector("[data-description-count]");
  const trabajoElegido = document.querySelector("[data-selected-product]");
  const vistaStl = document.querySelector("[data-stl-preview]");
  const lienzoStl = document.querySelector("[data-stl-container]");
  const mensajeStl = document.querySelector("[data-stl-message]");
  const selectorMaker = document.querySelector('[data-field="makerId"]');
  const campoFecha = document.querySelector('[data-field="deadline"]');
  const contextoBorrador = `${window.location.pathname}${window.location.search}`;

  const leerSesion = (clave) => {
    try {
      const valor = sessionStorage.getItem(clave);
      return valor ? JSON.parse(valor) : null;
    } catch {
      return null;
    }
  };

  const escribirSesion = (clave, valor) => {
    try {
      sessionStorage.setItem(clave, JSON.stringify(valor));
      return true;
    } catch {
      return false;
    }
  };

  const borrarSesion = (clave) => {
    try {
      sessionStorage.removeItem(clave);
    } catch {}
  };

  const mostrarError = (mensaje, objetivo) => {
    if (errorFormulario) {
      errorFormulario.textContent = mensaje;
      errorFormulario.hidden = false;
    }
    if (objetivo !== errorFormulario) objetivo?.setAttribute?.("aria-invalid", "true");
    objetivo?.focus?.();
  };

  const limpiarError = () => {
    if (errorFormulario) {
      errorFormulario.textContent = "";
      errorFormulario.hidden = true;
    }
  };

  const guardarBorrador = () => {
    const { designFileObject, ...datos } = pedido;
    escribirSesion(PEDIDO_BORRADOR_STORAGE_KEY, {
      version: 1,
      savedAt: Date.now(),
      context: contextoBorrador,
      hadFile: Boolean(designFileObject),
      data: {
        ...datos,
        designFileName: "",
        designFileSize: 0,
      },
    });
  };

  const restaurarBorrador = () => {
    const borrador = leerSesion(PEDIDO_BORRADOR_STORAGE_KEY);
    if (!borrador) return;
    if (
      borrador.version !== 1 ||
      !Number.isFinite(borrador.savedAt) ||
      Date.now() - borrador.savedAt > BORRADOR_TTL_MS ||
      !borrador.data
    ) {
      borrarSesion(PEDIDO_BORRADOR_STORAGE_KEY);
      return;
    }
    if (borrador.context !== contextoBorrador) return;

    const datos = borrador.data;
    const camposTexto = [
      "description",
      "color",
      "deadline",
      "name",
      "email",
      "phone",
      "requestId",
      "orderId",
    ];
    camposTexto.forEach((campo) => {
      if (typeof datos[campo] === "string") pedido[campo] = datos[campo];
    });

    if (datos.hasDesign === true || datos.hasDesign === false) pedido.hasDesign = datos.hasDesign;
    if (TAMANOS_PEDIDO.some(({ id }) => id === datos.size)) pedido.size = datos.size;
    if (MATERIALES_PEDIDO.some(({ id }) => id === datos.material)) pedido.material = datos.material;
    if (PRESUPUESTOS_PEDIDO.includes(datos.budget)) pedido.budget = datos.budget;
    if (typeof datos.makerId === "string") pedido.makerId = datos.makerId;

    if (avisoBorrador) {
      avisoBorrador.textContent = borrador.hadFile
        ? "Hemos recuperado tus respuestas. Por privacidad, tendrás que volver a elegir el STL si quieres previsualizarlo."
        : "Hemos recuperado las respuestas de esta sesión.";
      avisoBorrador.hidden = false;
    }
  };

  const marcarElegido = (grupo, valor) => {
    document.querySelectorAll(`[data-choice="${grupo}"]`).forEach((boton) => {
      boton.setAttribute("aria-pressed", String(boton.dataset.value === String(valor)));
    });
    document.querySelector(`[data-choice-group="${grupo}"]`)?.removeAttribute("aria-invalid");
  };

  const sincronizarCampos = () => {
    document.querySelectorAll("[data-field]").forEach((campo) => {
      const nombre = campo.dataset.field;
      if (nombre && nombre in pedido) campo.value = pedido[nombre] ?? "";
    });
    if (pedido.hasDesign !== null) marcarElegido("hasDesign", String(pedido.hasDesign));
    if (pedido.size) marcarElegido("size", pedido.size);
    marcarElegido("material", pedido.material);
    if (pedido.budget) marcarElegido("budget", pedido.budget);
    if (zonaSubida) zonaSubida.hidden = pedido.hasDesign !== true;
  };

  const actualizarContador = () => {
    if (!contador) return;
    const total = pedido.description.trim().length;
    contador.textContent =
      total >= 15
        ? `${total} de 2000 caracteres`
        : `${total} de 2000 caracteres · mínimo 15`;
    contador.toggleAttribute("data-completo", total >= 15);
  };

  const actualizarBoton = () => {
    if (!(botonSiguiente instanceof HTMLButtonElement)) return;
    const ultimo = paso === PASOS_PEDIDO.length - 1;
    botonSiguiente.disabled = enviando;
    botonSiguiente.innerHTML = enviando
      ? "Enviando…"
      : `${ultimo ? "Enviar solicitud" : "Continuar"} <span class="boton__flecha" aria-hidden="true">→</span>`;
  };

  const actualizarPaso = (enfocar = false) => {
    secciones.forEach((seccion) => {
      seccion.hidden = seccion.dataset.step !== String(paso);
    });

    if (botonAtras) {
      botonAtras.textContent =
        paso === 0
          ? origenMakerSlug
            ? "← Volver al taller"
            : "← Volver al inicio"
          : "← Paso anterior";
    }

    if (tituloPaso) tituloPaso.textContent = PASOS_PEDIDO[paso].titulo;
    if (pasoActual) pasoActual.textContent = String(paso + 1);

    const porcentaje = Math.round((paso / PASOS_PEDIDO.length) * 100);
    if (textoAvance) textoAvance.textContent = String(porcentaje);
    if (rellenoAvance) rellenoAvance.style.width = `${porcentaje}%`;
    if (barraAvance) barraAvance.setAttribute("aria-valuenow", String(porcentaje));

    if (notaPie) {
      notaPie.textContent =
        paso === PASOS_PEDIDO.length - 1
          ? "Solo confirmaremos la recepción cuando el envío termine"
          : "Sin compromiso hasta que apruebes la propuesta";
    }

    actualizarBoton();
    if (enfocar) {
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
      });
      tituloPaso?.focus?.({ preventScroll: true });
    }
  };

  const fechaMinimaLocal = () => {
    const fecha = new Date();
    fecha.setDate(fecha.getDate() + 7);
    const ano = fecha.getFullYear();
    const mes = String(fecha.getMonth() + 1).padStart(2, "0");
    const dia = String(fecha.getDate()).padStart(2, "0");
    return `${ano}-${mes}-${dia}`;
  };

  const validarPaso = (indice, anunciar = true) => {
    limpiarError();
    document.querySelectorAll('[aria-invalid="true"]').forEach((nodo) => {
      nodo.removeAttribute("aria-invalid");
    });

    let mensaje = "";
    let objetivo = null;

    if (indice === 0) {
      objetivo = document.querySelector('[data-field="description"]');
      if (pedido.description.trim().length < 15) {
        mensaje = "Describe la pieza con al menos 15 caracteres para poder valorarla.";
      } else if (pedido.description.trim().length > 2000) {
        mensaje = "Acorta la descripción a un máximo de 2000 caracteres.";
      }
    } else if (indice === 1 && pedido.hasDesign === null) {
      mensaje = "Indica si ya tienes el diseño o si partes solo de una idea.";
      objetivo = document.querySelector('[data-choice="hasDesign"]');
      document.querySelector('[data-choice-group="hasDesign"]')?.setAttribute("aria-invalid", "true");
    } else if (indice === 2 && !pedido.size) {
      mensaje = "Elige un tamaño aproximado para la pieza.";
      objetivo = document.querySelector('[data-choice="size"]');
      document.querySelector('[data-choice-group="size"]')?.setAttribute("aria-invalid", "true");
    } else if (indice === 3 && pedido.deadline && pedido.deadline < fechaMinimaLocal()) {
      mensaje = "Elige una fecha que deje al menos 7 días para valorar y producir la pieza.";
      objetivo = campoFecha;
    } else if (indice === 4) {
      const campoNombre = document.querySelector('[data-field="name"]');
      const campoEmail = document.querySelector('[data-field="email"]');
      pedido.name = pedido.name.trim();
      pedido.email = pedido.email.trim();
      if (campoNombre instanceof HTMLInputElement) campoNombre.value = pedido.name;
      if (campoEmail instanceof HTMLInputElement) campoEmail.value = pedido.email;
      if (
        !(campoNombre instanceof HTMLInputElement) ||
        pedido.name.length < 2 ||
        !campoNombre.validity.valid
      ) {
        mensaje = "Escribe tu nombre para que sepamos cómo dirigirnos a ti.";
        objetivo = campoNombre;
      } else if (!(campoEmail instanceof HTMLInputElement) || !campoEmail.validity.valid) {
        mensaje = "Escribe una dirección de email válida para que podamos responderte.";
        objetivo = campoEmail;
      }
    }

    if (mensaje && anunciar) mostrarError(mensaje, objetivo);
    return !mensaje;
  };

  const validarTodo = () => {
    for (let indice = 0; indice < PASOS_PEDIDO.length; indice += 1) {
      if (!validarPaso(indice, false)) {
        paso = indice;
        actualizarPaso(true);
        window.setTimeout(() => validarPaso(indice, true), 0);
        return false;
      }
    }
    return true;
  };

  const limpiarArchivo = () => {
    pedido.designFileName = "";
    pedido.designFileSize = 0;
    pedido.designFileObject = null;
    if (entradaArchivo instanceof HTMLInputElement) entradaArchivo.value = "";
    if (botonSubir) {
      botonSubir.querySelector(".brief__soltar-titulo").textContent =
        "Elegir STL para previsualizar";
      botonSubir.querySelector(".brief__soltar-nota").textContent = "No se sube ni se guarda";
      botonSubir.removeAttribute("data-cargado");
    }
    if (accionesArchivo) accionesArchivo.hidden = true;
    if (estadoArchivo) estadoArchivo.textContent = "";
    descartarVistaStl();
    guardarBorrador();
  };

  restaurarBorrador();

  if (selectorMaker instanceof HTMLSelectElement) {
    const parametros = new URLSearchParams(window.location.search);
    const makerPedido = parametros.get("maker");
    const opcionMaker = Array.from(selectorMaker.options).find(
      (opcion) => opcion.value === makerPedido && opcion.value !== "recommended",
    );

    const valorRestauradoValido = Array.from(selectorMaker.options).some(
      (opcion) => opcion.value === pedido.makerId,
    );
    selectorMaker.value = opcionMaker?.value ?? (valorRestauradoValido ? pedido.makerId : "recommended");
    pedido.makerId = selectorMaker.value;
    origenMakerSlug = opcionMaker?.dataset.slug ?? "";

    let trabajos = [];
    try {
      trabajos = JSON.parse(opcionMaker?.dataset.products || "[]");
    } catch {}

    const trabajo = trabajos.find((item) => item.id === parametros.get("product"));
    if (trabajo) {
      pedido.productId = trabajo.id;
      pedido.productName = trabajo.nombre;
      selectorMaker.disabled = true;
      if (trabajoElegido) {
        trabajoElegido.textContent = `Trabajo elegido: ${trabajo.nombre}. Completa los pasos para solicitar uno similar.`;
        trabajoElegido.hidden = false;
      }
    }
  }

  sincronizarCampos();
  actualizarContador();
  if (campoFecha instanceof HTMLInputElement) campoFecha.min = fechaMinimaLocal();

  document.querySelectorAll("[data-choice]").forEach((boton) => {
    boton.addEventListener("click", () => {
      const grupo = boton.dataset.choice;
      const bruto = boton.dataset.value || "";
      if (!grupo) return;
      pedido[grupo] = grupo === "hasDesign" ? bruto === "true" : bruto;
      marcarElegido(grupo, bruto);
      limpiarError();

      if (grupo === "hasDesign" && zonaSubida) {
        const tieneDiseno = bruto === "true";
        zonaSubida.hidden = !tieneDiseno;
        if (!tieneDiseno) limpiarArchivo();
      }

      guardarBorrador();
    });
  });

  document.querySelectorAll("[data-field]").forEach((campo) => {
    campo.addEventListener("input", () => {
      const nombre = campo.dataset.field;
      if (!nombre) return;
      pedido[nombre] = campo.value;
      campo.removeAttribute("aria-invalid");
      limpiarError();
      if (nombre === "description") actualizarContador();
      guardarBorrador();
    });
  });

  botonAtras?.addEventListener("click", () => {
    if (paso === 0) {
      window.location.href = origenMakerSlug ? `/productores/${origenMakerSlug}` : "/";
      return;
    }
    paso -= 1;
    limpiarError();
    actualizarPaso(true);
  });

  formulario?.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    if (enviando || !validarPaso(paso)) return;

    if (paso < PASOS_PEDIDO.length - 1) {
      paso += 1;
      actualizarPaso(true);
      return;
    }

    if (!validarTodo()) return;
    if (!(formulario instanceof HTMLFormElement)) return;

    if (!pedido.requestId || !pedido.orderId) {
      Object.assign(pedido, crearIdentidadPedido());
      guardarBorrador();
    }

    const makerNombre =
      selectorMaker instanceof HTMLSelectElement
        ? selectorMaker.selectedOptions[0]?.textContent?.trim() || "Lo elegimos nosotros"
        : "Lo elegimos nosotros";
    const datos = new FormData();
    const campos = {
      tipo: "pedido_cliente",
      _subject: `Nueva solicitud ${pedido.orderId}`,
      referencia: pedido.orderId,
      requestId: pedido.requestId,
      nombre: pedido.name.trim(),
      email: pedido.email.trim(),
      telefono: pedido.phone.trim() || "No indicado",
      descripcion: pedido.description.trim(),
      tieneDiseno: pedido.hasDesign ? "Sí" : "No, necesita ayuda con el diseño",
      stlSeleccionado: pedido.designFileObject
        ? "Sí. No se ha enviado ni guardado; solicitar al cliente por email."
        : "No",
      tamano: pedido.size,
      material: pedido.material,
      color: pedido.color.trim() || "Sin preferencia",
      fechaDeseada: pedido.deadline || "No indicada",
      presupuesto: pedido.budget || "No indicado",
      makerId: pedido.makerId,
      maker: makerNombre,
      productoId: pedido.productId || "No procede",
      producto: pedido.productName || "No procede",
    };
    Object.entries(campos).forEach(([nombre, valor]) => datos.append(nombre, valor));

    enviando = true;
    limpiarError();
    actualizarBoton();

    const controlador = new AbortController();
    const temporizador = window.setTimeout(() => controlador.abort(), 20000);

    try {
      const respuesta = await fetch(formulario.dataset.endpoint, {
        method: "POST",
        body: datos,
        headers: { Accept: "application/json" },
        signal: controlador.signal,
      });

      if (!respuesta.ok) {
        if (respuesta.status === 429) {
          throw new Error("Hemos alcanzado temporalmente el límite de solicitudes. Escríbenos a contacto@3dbok.com o inténtalo más tarde.");
        }
        if (respuesta.status === 400 || respuesta.status === 422) {
          throw new Error("Formspree no ha podido validar la solicitud. Revisa los datos e inténtalo de nuevo.");
        }
        throw new Error("No hemos podido enviar la solicitud. Tus respuestas siguen aquí para que puedas reintentarlo.");
      }

      const confirmacion = {
        version: 2,
        status: "submitted",
        submittedAt: Date.now(),
        orderId: pedido.orderId,
        requestId: pedido.requestId,
        email: pedido.email.trim(),
        description: pedido.description.trim(),
        hasDesign: pedido.hasDesign,
        stlSelected: Boolean(pedido.designFileObject),
        size: pedido.size,
        material: pedido.material,
        deadline: pedido.deadline,
        budget: pedido.budget,
        makerNombre,
        productName: pedido.productName,
      };
      const guardada = escribirSesion(PEDIDO_CONFIRMACION_STORAGE_KEY, confirmacion);
      borrarSesion(PEDIDO_BORRADOR_STORAGE_KEY);
      window.location.href = guardada
        ? "/confirmacion"
        : `/confirmacion?referencia=${encodeURIComponent(pedido.orderId)}`;
    } catch (error) {
      enviando = false;
      actualizarBoton();
      const mensaje =
        error instanceof DOMException && error.name === "AbortError"
          ? `El envío está tardando demasiado y no podemos confirmar si llegó. Espera un momento y reinténtalo una sola vez, o escríbenos a contacto@3dbok.com indicando la referencia ${pedido.orderId}.`
          : error instanceof Error
            ? error.message
            : "No hemos podido enviar la solicitud. Tus respuestas siguen aquí para que puedas reintentarlo.";
      mostrarError(mensaje, errorFormulario);
    } finally {
      window.clearTimeout(temporizador);
    }
  });

  botonSubir?.addEventListener("click", () => {
    if (entradaArchivo instanceof HTMLInputElement) entradaArchivo.click();
  });

  botonQuitarArchivo?.addEventListener("click", limpiarArchivo);

  entradaArchivo?.addEventListener("change", () => {
    if (!(entradaArchivo instanceof HTMLInputElement)) return;
    const archivo = entradaArchivo.files?.[0] || null;
    if (!archivo) {
      limpiarArchivo();
      return;
    }

    if (!archivo.name.toLowerCase().endsWith(".stl")) {
      limpiarArchivo();
      mostrarError("Elige un archivo con extensión .stl para previsualizarlo.", botonSubir);
      return;
    }

    pedido.designFileName = archivo.name;
    pedido.designFileSize = archivo.size;
    pedido.designFileObject = archivo;
    if (botonSubir) {
      botonSubir.querySelector(".brief__soltar-titulo").textContent = archivo.name;
      botonSubir.querySelector(".brief__soltar-nota").textContent = "Pulsa aquí para elegir otro";
      botonSubir.setAttribute("data-cargado", "");
    }
    if (accionesArchivo) accionesArchivo.hidden = false;
    if (estadoArchivo) {
      estadoArchivo.textContent =
        "Seleccionado solo para esta previsualización. No se enviará ni se guardará.";
    }
    limpiarError();
    guardarBorrador();

    if (archivo.size > MAX_STL_PREVIEW_BYTES) {
      descartarVistaStl();
      if (accionesArchivo) accionesArchivo.hidden = false;
      if (estadoArchivo) {
        estadoArchivo.textContent =
          "El archivo es demasiado grande para previsualizarlo aquí. No se enviará; te lo pediremos por email.";
      }
      return;
    }
    dibujarStl(archivo);
  });

  actualizarPaso();
  window.addEventListener("pagehide", () => descartarVistaStl(), { once: true });

  function descartarVistaStl() {
    if (descartarVista) descartarVista();
    descartarVista = null;
    if (lienzoStl) lienzoStl.innerHTML = "";
    if (vistaStl) vistaStl.hidden = true;
    if (mensajeStl) {
      mensajeStl.textContent = "Arrastra para girar la pieza, rueda para acercar.";
      mensajeStl.removeAttribute("data-error");
    }
  }

  async function dibujarStl(archivo) {
    descartarVistaStl();
    if (!vistaStl || !lienzoStl || !mensajeStl) return;
    vistaStl.hidden = false;

    let descartado = false;
    let fotograma = 0;
    let renderizador;
    let controles;
    let observador;
    let geometria;
    let escena;
    let camara;

    descartarVista = () => {
      descartado = true;
      cancelAnimationFrame(fotograma);
      observador?.disconnect();
      controles?.dispose();
      geometria?.dispose();
      escena?.traverse((objeto) => {
        const materiales = Array.isArray(objeto.material) ? objeto.material : [objeto.material];
        materiales.filter(Boolean).forEach((material) => material.dispose?.());
      });
      renderizador?.dispose();
      renderizador?.domElement?.remove();
    };

    const redimensionar = () => {
      if (!renderizador || !camara || !lienzoStl.clientWidth || !lienzoStl.clientHeight) return;
      camara.aspect = lienzoStl.clientWidth / lienzoStl.clientHeight;
      camara.updateProjectionMatrix();
      renderizador.setSize(lienzoStl.clientWidth, lienzoStl.clientHeight, false);
      renderizador.render(escena, camara);
    };

    try {
      const [THREE, { OrbitControls }, { STLLoader }, datos] = await Promise.all([
        import("three"),
        import("three/examples/jsm/controls/OrbitControls.js"),
        import("three/examples/jsm/loaders/STLLoader.js"),
        archivo.arrayBuffer(),
      ]);
      if (descartado) return;

      escena = new THREE.Scene();
      escena.background = new THREE.Color(0xdedbd2);

      camara = new THREE.PerspectiveCamera(45, 1, 0.1, 1000);
      camara.position.set(90, 70, 110);

      const luzPrincipal = new THREE.DirectionalLight(0xffffff, 2.2);
      luzPrincipal.position.set(80, 120, 90);
      escena.add(luzPrincipal);
      escena.add(new THREE.HemisphereLight(0xffffff, 0xb8ac91, 1.6));

      renderizador = new THREE.WebGLRenderer({ antialias: true });
      renderizador.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderizador.outputColorSpace = THREE.SRGBColorSpace;
      renderizador.setSize(lienzoStl.clientWidth, lienzoStl.clientHeight, false);
      renderizador.domElement.setAttribute("role", "img");
      renderizador.domElement.setAttribute("aria-label", `Previsualización local de ${archivo.name}`);
      lienzoStl.appendChild(renderizador.domElement);

      controles = new OrbitControls(camara, renderizador.domElement);
      controles.enableDamping = true;
      controles.dampingFactor = 0.08;

      observador = new ResizeObserver(redimensionar);
      observador.observe(lienzoStl);

      geometria = new STLLoader().parse(datos);
      geometria.computeVertexNormals();

      const malla = new THREE.Mesh(
        geometria,
        new THREE.MeshStandardMaterial({ color: 0xe8dfcd, roughness: 0.5, metalness: 0.05 }),
      );

      const caja = new THREE.Box3().setFromObject(malla);
      const medidas = caja.getSize(new THREE.Vector3());
      malla.position.sub(caja.getCenter(new THREE.Vector3()));
      malla.scale.setScalar(72 / (Math.max(medidas.x, medidas.y, medidas.z) || 1));
      malla.rotation.x = -Math.PI / 2;
      escena.add(malla);

      controles.target.set(0, 0, 0);
      controles.update();

      const animar = () => {
        fotograma = requestAnimationFrame(animar);
        controles.update();
        renderizador.render(escena, camara);
      };
      redimensionar();
      animar();
    } catch {
      mensajeStl.textContent =
        "No hemos podido previsualizar este STL. No se enviará; te lo pediremos por email.";
      mensajeStl.setAttribute("data-error", "");
    }
  }
</script>
