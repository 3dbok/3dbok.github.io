---
import BaseLayout from "../layouts/BaseLayout.astro";
import productores from "../data/productores.json";

const PASOS = [
  { id: "descripcion", titulo: "Cuéntanos tu idea" },
  { id: "diseno", titulo: "¿Ya tienes el diseño?" },
  { id: "tamano", titulo: "¿De qué tamaño?" },
  { id: "detalles", titulo: "Últimos detalles" },
  { id: "contacto", titulo: "¿Cómo te avisamos?" },
];

const TAMANOS = [
  { id: "xs", etiqueta: "Pequeño", nota: "Como una moneda", medida: "menos de 5 cm" },
  { id: "s", etiqueta: "Compacto", nota: "Como un móvil", medida: "5 – 15 cm" },
  { id: "m", etiqueta: "Mediano", nota: "Como un libro", medida: "15 – 30 cm" },
  { id: "l", etiqueta: "Grande", nota: "Como una mochila", medida: "más de 30 cm" },
];

const MATERIALES = [
  { id: "any", etiqueta: "Que elija el maker", nota: "Lo normal si no lo tienes claro" },
  { id: "pla", etiqueta: "PLA", nota: "Rígido y económico" },
  { id: "resin", etiqueta: "Resina", nota: "Máximo detalle, superficie lisa" },
  { id: "petg", etiqueta: "PETG", nota: "Aguanta golpes, calor y humedad" },
];

const PRESUPUESTOS = ["Menos de 20 €", "20 – 50 €", "50 – 100 €", "Aún no lo sé"];
---

<BaseLayout
  title="Pedir una pieza"
  descripcion="Describe la pieza que necesitas en cinco pasos. Recibirás un boceto antes de que nadie empiece a imprimir."
>
  <main class="brief">
    <div class="envoltura--angosta">
      <button class="brief__volver dato" data-back type="button">
        ← Volver al inicio
      </button>

      <div class="brief__avance">
        <div class="brief__avance-datos dato">
          <span>Paso <span data-step-current>1</span> de {PASOS.length}</span>
          <span><span data-progress-text>0</span> % completado</span>
        </div>
        <div
          class="brief__barra"
          role="progressbar"
          aria-label="Progreso del pedido"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          data-progress-bar
        >
          <div class="brief__barra-relleno" data-progress-fill></div>
        </div>
      </div>

      <h1 class="brief__titulo" data-step-title>{PASOS[0].titulo}</h1>

      <section data-step="0">
        <p class="brief__ayuda">
          Escríbelo como se lo contarías a un amigo. Cuanto más detalle nos des,
          menos vueltas dará el boceto.
        </p>
        <label class="solo-lectores" for="brief-descripcion">Describe la pieza</label>
        <textarea
          class="entrada"
          id="brief-descripcion"
          data-field="description"
          rows="7"
          placeholder="Por ejemplo: quiero una miniatura de un dragón negro de unos 10 cm, con las alas desplegadas y postura amenazante. Es para mi partida de rol y quiero que imponga…"
        ></textarea>
        <p class="brief__contador dato" data-description-count>
          0 caracteres · mínimo 15
        </p>
      </section>

      <section data-step="1" hidden>
        <p class="brief__ayuda">
          Si ya tienes un archivo 3D (.STL) lo usamos tal cual. Si no, un
          diseñador lo crea a partir de lo que nos acabas de contar.
        </p>
        <div class="brief__opciones">
          {
            [
              {
                valor: false,
                etiqueta: "Solo tengo la idea",
                nota: "Un diseñador la convierte en un modelo y te lo enseña",
              },
              {
                valor: true,
                etiqueta: "Ya tengo el diseño",
                nota: "Súbelo y pasamos directamente a imprimir",
              },
            ].map((opcion) => (
              <button
                class="opcion"
                type="button"
                data-choice="hasDesign"
                data-value={String(opcion.valor)}
                aria-pressed="false"
              >
                <span class="opcion__titulo">{opcion.etiqueta}</span>
                <span class="opcion__nota">{opcion.nota}</span>
              </button>
            ))
          }
        </div>

        <div class="brief__subida" data-design-upload hidden>
          <input
            data-design-file
            type="file"
            accept=".stl"
            hidden
          />
          <button class="brief__soltar" type="button" data-design-upload-button>
            <span class="brief__soltar-titulo">Subir archivo .STL</span>
            <span class="brief__soltar-nota dato">Lo verás aquí mismo antes de enviarlo</span>
          </button>
          <div class="brief__vista" data-stl-preview hidden>
            <div class="brief__lienzo" data-stl-container></div>
            <p class="brief__ayuda-corta dato" data-stl-message>
              Arrastra para girar la pieza, rueda para acercar.
            </p>
          </div>
        </div>
      </section>

      <section data-step="2" hidden>
        <p class="brief__elegido" data-selected-product hidden></p>
        <p class="brief__ayuda">
          Con una referencia aproximada basta. El diseñador ajusta las medidas
          exactas contigo.
        </p>
        <div class="brief__rejilla">
          {
            TAMANOS.map((tamano) => (
              <button
                class="opcion"
                type="button"
                data-choice="size"
                data-value={tamano.id}
                aria-pressed="false"
              >
                <span class="opcion__titulo">{tamano.etiqueta}</span>
                <span class="opcion__nota">{tamano.nota}</span>
                <span class="opcion__medida">{tamano.medida}</span>
              </button>
            ))
          }
        </div>
      </section>

      <section data-step="3" hidden>
        <div class="brief__campos">
          <div class="campo">
            <label class="campo__nombre" for="brief-maker">Quién lo imprime</label>
            <p class="campo__ayuda">
              Puedes elegir un maker concreto o dejar que te propongamos el más
              adecuado para tu pieza.
            </p>
            <select class="entrada" id="brief-maker" data-field="makerId">
              <option value="recommended">Que 3dbok elija por mí</option>
              {
                productores.map((productor) => (
                  <option
                    value={productor.id}
                    data-slug={productor.slug}
                    data-products={JSON.stringify(
                      productor.productos.map(({ id, nombre }) => ({ id, nombre })),
                    )}
                  >
                    {productor.nombre} — {productor.ubicacion}
                  </option>
                ))
              }
            </select>
          </div>

          <div class="campo">
            <span class="campo__nombre">Material</span>
            <div class="brief__rejilla">
              {
                MATERIALES.map((material) => (
                  <button
                    class="opcion"
                    type="button"
                    data-choice="material"
                    data-value={material.id}
                    aria-pressed="false"
                  >
                    <span class="opcion__titulo">{material.etiqueta}</span>
                    <span class="opcion__nota">{material.nota}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <div class="campo">
            <label class="campo__nombre" for="brief-color">Color</label>
            <p class="campo__ayuda">
              Descríbelo con tus palabras. Si te da igual, déjalo en blanco.
            </p>
            <input
              class="entrada"
              id="brief-color"
              data-field="color"
              type="text"
              placeholder="Negro mate, rojo sangre, madera natural…"
            />
          </div>

          <div class="campo">
            <label class="campo__nombre" for="brief-fecha">Para cuándo lo necesitas</label>
            <input class="entrada" id="brief-fecha" data-field="deadline" type="date" />
          </div>

          <div class="campo">
            <span class="campo__nombre">Presupuesto aproximado</span>
            <p class="campo__ayuda">
              Solo orienta al diseñador. No es un compromiso ni un precio final.
            </p>
            <div class="fila-opciones">
              {
                PRESUPUESTOS.map((presupuesto) => (
                  <button
                    class="opcion opcion--pastilla"
                    type="button"
                    data-choice="budget"
                    data-value={presupuesto}
                    aria-pressed="false"
                  >
                    {presupuesto}
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section data-step="4" hidden>
        <p class="brief__ayuda">
          Es para mandarte el boceto y avisarte de cómo va el pedido. Nada más.
        </p>
        <div class="brief__campos">
          <div class="campo">
            <label class="campo__nombre" for="brief-nombre">Nombre</label>
            <input class="entrada" id="brief-nombre" data-field="name" type="text" autocomplete="name" placeholder="Tu nombre" />
          </div>
          <div class="campo">
            <label class="campo__nombre" for="brief-email">Email</label>
            <input class="entrada" id="brief-email" data-field="email" type="email" autocomplete="email" placeholder="tu@email.com" />
          </div>
          <div class="campo">
            <label class="campo__nombre" for="brief-tel">Teléfono <span class="campo__opcional">(opcional)</span></label>
            <input class="entrada" id="brief-tel" data-field="phone" type="tel" autocomplete="tel" placeholder="+34 600 000 000" />
          </div>
        </div>

        <p class="brief__privacidad">
          Usamos tus datos únicamente para gestionar este pedido. No los
          compartimos con nadie más.
        </p>
      </section>

      <div class="brief__pie">
        <p class="brief__nota dato" data-footer-note>
          Sin compromiso hasta que apruebes el boceto
        </p>
        <button class="boton boton--principal" data-next type="button" disabled>
          Continuar <span class="boton__flecha" aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .brief {
    padding-block: clamp(1.75rem, 1rem + 2.5vw, 3rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .brief__volver {
    padding: 0;
    border: 0;
    background: none;
    color: var(--tinta-suave);
    cursor: pointer;
  }

  .brief__volver:hover {
    color: var(--tinta);
    text-decoration: underline;
  }

  .brief__avance {
    margin-top: 2rem;
  }

  .brief__avance-datos {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
    color: var(--tinta-suave);
  }

  .brief__barra {
    height: 3px;
    background: var(--bancada-honda);
    overflow: hidden;
  }

  .brief__barra-relleno {
    height: 100%;
    width: 20%;
    background: var(--filamento);
    transition: width 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .brief__titulo {
    margin-top: 1.75rem;
    margin-bottom: 1.5rem;
    font-size: var(--paso-3);
  }

  .brief__ayuda {
    margin-bottom: 1.25rem;
    color: var(--tinta-media);
    line-height: 1.6;
  }

  .brief__contador {
    margin-top: 0.55rem;
    color: var(--tinta-suave);
  }

  .brief__contador[data-completo] {
    color: var(--verde);
  }

  .brief__opciones {
    display: grid;
    gap: 0.65rem;
  }

  .brief__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    gap: 0.65rem;
  }

  .brief__campos {
    display: grid;
    gap: 1.6rem;
  }

  .campo__opcional {
    color: var(--tinta-suave);
    font-weight: 400;
  }

  .brief__elegido {
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
    border-left: 3px solid var(--filamento);
    background: var(--pieza);
    font-size: 0.93rem;
  }

  /* --- Subida y vista del STL ------------------------------------------ */

  .brief__subida {
    margin-top: 1.25rem;
  }

  .brief__soltar {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
    padding: 1.4rem 1.25rem;
    border: 1px dashed var(--linea-fuerte);
    border-radius: var(--r-2);
    background: var(--pieza);
    cursor: pointer;
    text-align: center;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }

  .brief__soltar:hover {
    border-color: var(--cianotipo);
    background: var(--cianotipo-lavado);
  }

  .brief__soltar-titulo {
    font-weight: 600;
  }

  .brief__soltar-nota {
    color: var(--tinta-suave);
  }

  .brief__soltar[data-cargado] {
    border-style: solid;
    border-color: var(--verde);
  }

  .brief__vista {
    margin-top: 0.9rem;
  }

  .brief__lienzo {
    height: 300px;
    border: 1px solid var(--linea);
    border-radius: var(--r-2);
    background: var(--bancada-honda);
    overflow: hidden;
  }

  .brief__ayuda-corta {
    margin-top: 0.5rem;
    color: var(--tinta-suave);
  }

  .brief__ayuda-corta[data-error] {
    color: var(--alerta);
  }

  .brief__privacidad {
    margin-top: 1.5rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--linea);
    border-radius: var(--r-2);
    background: var(--pieza);
    font-size: 0.88rem;
    color: var(--tinta-suave);
    line-height: 1.55;
  }

  /* --- Pie de navegación ------------------------------------------------ */

  .brief__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--linea);
  }

  .brief__nota {
    color: var(--tinta-suave);
  }

  @media (max-width: 480px) {
    .brief__pie {
      flex-direction: column-reverse;
      align-items: stretch;
    }

    .brief__pie .boton {
      justify-content: center;
    }

    .brief__nota {
      text-align: center;
    }
  }
</style>

<script>
  const pasos = [
    "Cuéntanos tu idea",
    "¿Ya tienes el diseño?",
    "¿De qué tamaño?",
    "Últimos detalles",
    "¿Cómo te avisamos?",
  ];

  let paso = 0;
  let pasoDeEntrada = 0;
  let enviando = false;
  let descartarVista = null;

  const pedido = {
    description: "",
    hasDesign: null,
    designFile: null,
    designFileObject: null,
    size: "",
    color: "",
    material: "any",
    deadline: "",
    budget: "",
    name: "",
    email: "",
    phone: "",
    makerId: "recommended",
    productId: "",
  };

  const secciones = Array.from(document.querySelectorAll("[data-step]"));
  const botonAtras = document.querySelector("[data-back]");
  const botonSiguiente = document.querySelector("[data-next]");
  const titulo = document.querySelector("[data-step-title]");
  const pasoActual = document.querySelector("[data-step-current]");
  const textoAvance = document.querySelector("[data-progress-text]");
  const barraAvance = document.querySelector("[data-progress-bar]");
  const rellenoAvance = document.querySelector("[data-progress-fill]");
  const notaPie = document.querySelector("[data-footer-note]");
  const zonaSubida = document.querySelector("[data-design-upload]");
  const entradaArchivo = document.querySelector("[data-design-file]");
  const botonSubir = document.querySelector("[data-design-upload-button]");
  const contador = document.querySelector("[data-description-count]");
  const trabajoElegido = document.querySelector("[data-selected-product]");
  const vistaStl = document.querySelector("[data-stl-preview]");
  const lienzoStl = document.querySelector("[data-stl-container]");
  const mensajeStl = document.querySelector("[data-stl-message]");

  const puedeSeguir = () => {
    if (paso === 0) return pedido.description.trim().length >= 15;
    if (paso === 1) return pedido.hasDesign !== null;
    if (paso === 2) return Boolean(pedido.size);
    if (paso === 4) return pedido.name.trim().length > 1 && pedido.email.includes("@");
    return true;
  };

  const actualizarBoton = () => {
    if (!(botonSiguiente instanceof HTMLButtonElement)) return;
    const ultimo = paso === pasos.length - 1;
    botonSiguiente.disabled = !puedeSeguir() || enviando;
    botonSiguiente.innerHTML = enviando
      ? "Enviando…"
      : `${ultimo ? "Enviar el pedido" : "Continuar"} <span class="boton__flecha" aria-hidden="true">→</span>`;
  };

  const actualizarPaso = () => {
    secciones.forEach((seccion) => {
      seccion.hidden = seccion.dataset.step !== String(paso);
    });

    if (botonAtras) {
      botonAtras.textContent =
        paso === pasoDeEntrada
          ? pasoDeEntrada === 3
            ? "← Volver al taller"
            : "← Volver al inicio"
          : "← Paso anterior";
    }

    if (titulo) titulo.textContent = pasos[paso];
    if (pasoActual) pasoActual.textContent = String(paso + 1);

    const porcentaje = Math.round(((paso + 1) / pasos.length) * 100);
    if (textoAvance) textoAvance.textContent = String(porcentaje);
    if (rellenoAvance) rellenoAvance.style.width = `${porcentaje}%`;
    if (barraAvance) barraAvance.setAttribute("aria-valuenow", String(porcentaje));

    if (notaPie) {
      notaPie.textContent =
        paso === pasos.length - 1
          ? "Te llega un email de confirmación al enviarlo"
          : "Sin compromiso hasta que apruebes el boceto";
    }

    actualizarBoton();
  };

  const marcarElegido = (grupo, valor) => {
    document.querySelectorAll(`[data-choice="${grupo}"]`).forEach((boton) => {
      boton.setAttribute("aria-pressed", String(boton.dataset.value === String(valor)));
    });
  };

  document.querySelectorAll("[data-choice]").forEach((boton) => {
    boton.addEventListener("click", () => {
      const grupo = boton.dataset.choice;
      const bruto = boton.dataset.value || "";
      pedido[grupo] = grupo === "hasDesign" ? bruto === "true" : bruto;
      marcarElegido(grupo, bruto);

      if (grupo === "hasDesign" && zonaSubida) {
        const tieneDiseno = bruto === "true";
        zonaSubida.hidden = !tieneDiseno;
        if (!tieneDiseno) {
          pedido.designFile = null;
          pedido.designFileObject = null;
          descartarVistaStl();
        }
      }

      actualizarBoton();
    });
  });

  document.querySelectorAll("[data-field]").forEach((campo) => {
    campo.addEventListener("input", () => {
      pedido[campo.dataset.field] = campo.value;

      if (campo.dataset.field === "description" && contador) {
        const total = pedido.description.trim().length;
        contador.textContent =
          total >= 15 ? `${total} caracteres` : `${total} caracteres · mínimo 15`;
        contador.toggleAttribute("data-completo", total >= 15);
      }

      actualizarBoton();
    });
  });

  // Si se llega desde la ficha de un maker, se salta a "Últimos detalles"
  // con ese maker y ese trabajo ya seleccionados.
  const selectorMaker = document.querySelector('[data-field="makerId"]');
  if (selectorMaker instanceof HTMLSelectElement) {
    const parametros = new URLSearchParams(window.location.search);
    const makerPedido = parametros.get("maker");
    const existe = Array.from(selectorMaker.options).some(
      (opcion) => opcion.value === makerPedido && opcion.value !== "recommended",
    );
    selectorMaker.value = existe ? makerPedido : "recommended";
    pedido.makerId = selectorMaker.value;

    let trabajos = [];
    try {
      trabajos = JSON.parse(selectorMaker.selectedOptions[0]?.dataset.products || "[]");
    } catch {}

    const trabajo = trabajos.find((item) => item.id === parametros.get("product"));
    if (trabajo) {
      pedido.productId = trabajo.id;
      paso = 3;
      pasoDeEntrada = 3;
      selectorMaker.disabled = true;
      if (trabajoElegido) {
        trabajoElegido.textContent = `Trabajo elegido: ${trabajo.nombre}`;
        trabajoElegido.hidden = false;
      }
    }
  }

  botonAtras?.addEventListener("click", () => {
    if (paso === pasoDeEntrada) {
      const slug =
        selectorMaker instanceof HTMLSelectElement
          ? selectorMaker.selectedOptions[0]?.dataset.slug
          : null;
      window.location.href =
        pasoDeEntrada === 3 ? (slug ? `/productores/${slug}` : "/productores") : "/";
      return;
    }
    paso -= 1;
    actualizarPaso();
    window.scrollTo({ top: 0 });
  });

  botonSiguiente?.addEventListener("click", async () => {
    if (!puedeSeguir() || enviando) return;

    if (paso < pasos.length - 1) {
      paso += 1;
      actualizarPaso();
      window.scrollTo({ top: 0 });
      return;
    }

    enviando = true;
    actualizarBoton();
    await new Promise((resolver) => setTimeout(resolver, 900));
    const referencia = `3DB-${Math.random().toString(36).slice(2, 7).toUpperCase()}`;
    const { designFileObject, ...datos } = pedido;
    const maker =
      selectorMaker instanceof HTMLSelectElement
        ? selectorMaker.selectedOptions[0]?.textContent?.trim()
        : "";
    sessionStorage.setItem(
      "3dbok-pedido",
      JSON.stringify({ ...datos, makerNombre: maker, orderId: referencia }),
    );
    window.location.href = "/confirmacion";
  });

  botonSubir?.addEventListener("click", () => {
    if (entradaArchivo instanceof HTMLInputElement) entradaArchivo.click();
  });

  entradaArchivo?.addEventListener("change", () => {
    if (!(entradaArchivo instanceof HTMLInputElement)) return;
    const archivo = entradaArchivo.files?.[0] || null;
    pedido.designFile = archivo?.name || null;
    pedido.designFileObject = archivo;

    if (botonSubir) {
      const titulo = botonSubir.querySelector(".brief__soltar-titulo");
      const nota = botonSubir.querySelector(".brief__soltar-nota");
      if (titulo) titulo.textContent = archivo ? archivo.name : "Subir archivo .STL";
      if (nota) {
        nota.textContent = archivo
          ? "Pulsa aquí si quieres cambiarlo"
          : "Lo verás aquí mismo antes de enviarlo";
      }
      botonSubir.toggleAttribute("data-cargado", Boolean(archivo));
    }

    if (archivo?.name?.toLowerCase().endsWith(".stl")) dibujarStl(archivo);
    else descartarVistaStl();
  });

  const campoFecha = document.querySelector('[data-field="deadline"]');
  if (campoFecha instanceof HTMLInputElement) {
    campoFecha.min = new Date(Date.now() + 7 * 864e5).toISOString().slice(0, 10);
  }

  marcarElegido("material", "any");
  actualizarPaso();

  function descartarVistaStl() {
    if (descartarVista) descartarVista();
    descartarVista = null;
    if (lienzoStl) lienzoStl.innerHTML = "";
    if (vistaStl) vistaStl.hidden = true;
    if (mensajeStl) {
      mensajeStl.textContent = "Arrastra para girar la pieza, rueda para acercar.";
      mensajeStl.removeAttribute("data-error");
    }
  }

  async function dibujarStl(archivo) {
    descartarVistaStl();
    if (!vistaStl || !lienzoStl || !mensajeStl) return;
    vistaStl.hidden = false;

    let descartado = false;
    let fotograma = 0;
    let renderizador;
    let controles;
    let observador;
    let geometria;
    let escena;
    let camara;

    descartarVista = () => {
      descartado = true;
      cancelAnimationFrame(fotograma);
      observador?.disconnect();
      controles?.dispose();
      geometria?.dispose();
      escena?.traverse((objeto) => objeto.material?.dispose());
      renderizador?.dispose();
      renderizador?.domElement?.remove();
    };

    const redimensionar = () => {
      if (!renderizador || !camara || !lienzoStl.clientWidth || !lienzoStl.clientHeight) return;
      camara.aspect = lienzoStl.clientWidth / lienzoStl.clientHeight;
      camara.updateProjectionMatrix();
      renderizador.setSize(lienzoStl.clientWidth, lienzoStl.clientHeight, false);
      renderizador.render(escena, camara);
    };

    try {
      const [THREE, { OrbitControls }, { STLLoader }, datos] = await Promise.all([
        import("three"),
        import("three/examples/jsm/controls/OrbitControls.js"),
        import("three/examples/jsm/loaders/STLLoader.js"),
        archivo.arrayBuffer(),
      ]);
      if (descartado) return;

      escena = new THREE.Scene();
      escena.background = new THREE.Color(0xdedbd2);

      camara = new THREE.PerspectiveCamera(45, 1, 0.1, 1000);
      camara.position.set(90, 70, 110);

      const luzPrincipal = new THREE.DirectionalLight(0xffffff, 2.2);
      luzPrincipal.position.set(80, 120, 90);
      escena.add(luzPrincipal);
      escena.add(new THREE.HemisphereLight(0xffffff, 0xb8ac91, 1.6));

      renderizador = new THREE.WebGLRenderer({ antialias: true });
      renderizador.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderizador.outputColorSpace = THREE.SRGBColorSpace;
      renderizador.setSize(lienzoStl.clientWidth, lienzoStl.clientHeight, false);
      lienzoStl.appendChild(renderizador.domElement);

      controles = new OrbitControls(camara, renderizador.domElement);
      controles.enableDamping = true;
      controles.dampingFactor = 0.08;

      observador = new ResizeObserver(redimensionar);
      observador.observe(lienzoStl);

      geometria = new STLLoader().parse(datos);
      geometria.computeVertexNormals();

      const malla = new THREE.Mesh(
        geometria,
        new THREE.MeshStandardMaterial({ color: 0xe8dfcd, roughness: 0.5, metalness: 0.05 }),
      );

      const caja = new THREE.Box3().setFromObject(malla);
      const medidas = caja.getSize(new THREE.Vector3());
      malla.position.sub(caja.getCenter(new THREE.Vector3()));
      malla.scale.setScalar(72 / (Math.max(medidas.x, medidas.y, medidas.z) || 1));
      malla.rotation.x = -Math.PI / 2;
      escena.add(malla);

      controles.target.set(0, 0, 0);
      controles.update();

      const animar = () => {
        fotograma = requestAnimationFrame(animar);
        controles.update();
        renderizador.render(escena, camara);
      };
      redimensionar();
      animar();
    } catch (fallo) {
      mensajeStl.textContent =
        "No se ha podido abrir este STL. Envíalo igualmente y lo revisamos a mano.";
      mensajeStl.setAttribute("data-error", "");
    }
  }
</script>
