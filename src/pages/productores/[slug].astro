---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MaterialChip from "../../components/MaterialChip.astro";
import Estrellas from "../../components/Estrellas.astro";
import productores from "../../data/productores.json";
import resenasData from "../../data/resenas.json";
import { MATERIALES, calcularMediaValoracion } from "../../lib/productorShared.js";
import "../../styles/ProductorPage.css";

export function getStaticPaths() {
  return productores.map((productor) => ({
    params: { slug: productor.slug },
    props: { productor },
  }));
}

const { productor } = Astro.props;

const opiniones = resenasData
  .filter((resena) => resena.productorId === productor.id && resena.aprobada)
  .sort((a, b) => new Date(b.fecha).getTime() - new Date(a.fecha).getTime());
const { media } = calcularMediaValoracion(productor.id, resenasData);

const fichaTecnica = [
  { clave: "Impresoras", valor: productor.impresoras.join(" · ") },
  { clave: "Materiales", valor: productor.materiales.join(" · ") },
  { clave: "Boquillas", valor: productor.tamNozzle.join(" · ") },
  { clave: "Respuesta", valor: `~${productor.tiempoRespuestaHoras} h` },
];

const FORMSPREE_RESENAS_ENDPOINT = "https://formspree.io/f/mvzjyjrb";
---

<BaseLayout
  title={productor.nombre}
  descripcion={`${productor.nombre} imprime en 3D desde ${productor.ubicacion}. Mira sus trabajos, sus materiales y las opiniones de otros clientes antes de encargar.`}
>
  <main class="ficha">
    <div class="envoltura">
      <header class="ficha__cabecera">
        <a href="/productores" class="ficha__volver dato">← Todos los makers</a>

        <div class="ficha__identidad">
          <img
            class="ficha__retrato"
            src={productor.foto}
            alt=""
            width="104"
            height="104"
          />
          <div>
            <p class="ficha__sello etiqueta">Maker verificado</p>
            <h1 class="ficha__nombre">{productor.nombre}</h1>
            <div class="ficha__datos dato">
              <span>{productor.ubicacion}</span>
              <span>Responde en ~{productor.tiempoRespuestaHoras} h</span>
              {
                media !== null && (
                  <span class="ficha__nota">
                    <Estrellas valor={media} />
                    {media.toFixed(1)} ({opiniones.length})
                  </span>
                )
              }
            </div>
            <div class="ficha__materiales">
              {productor.materiales.map((codigo) => <MaterialChip codigo={codigo} />)}
            </div>
          </div>
        </div>

        <div class="ficha__encargo en-cianotipo">
          <p class="ficha__encargo-texto">
            <strong>¿Quieres encargarle algo a {productor.nombre}?</strong>
            Cuéntanos la pieza y le llega directamente a su taller.
          </p>
          <a
            class="boton boton--claro"
            href={`/briefing?maker=${encodeURIComponent(productor.id)}`}
          >
            Empezar el encargo
            <span class="boton__flecha" aria-hidden="true">→</span>
          </a>
        </div>
      </header>

      <div class="ficha__cuerpo">
        <aside class="ficha__barra">
          <section class="ficha__bloque">
            <h2 class="ficha__bloque-titulo etiqueta">Sobre el maker</h2>
            <p class="ficha__bio">{productor.bio}</p>
          </section>

          <section class="ficha__bloque">
            <h2 class="ficha__bloque-titulo etiqueta">Especialidades</h2>
            <ul class="ficha__lista">
              {productor.especialidades.map((especialidad) => <li>{especialidad}</li>)}
            </ul>
          </section>

          <section class="ficha__bloque">
            <h2 class="ficha__bloque-titulo etiqueta">Ficha técnica</h2>
            <dl class="ficha__tecnica dato">
              {
                fichaTecnica.map((linea) => (
                  <div>
                    <dt>{linea.clave}</dt>
                    <dd>{linea.valor}</dd>
                  </div>
                ))
              }
            </dl>
          </section>
        </aside>

        <div>
          <h2 class="ficha__seccion-titulo">Trabajos publicados</h2>
          {
            productor.productos.length === 0 ? (
              <p class="ficha__vacio">
                Todavía no ha publicado ningún trabajo. Puedes encargarle una
                pieza igualmente.
              </p>
            ) : (
              <div class="trabajos">
                {productor.productos.map((producto) => (
                  <a
                    class="trabajo"
                    href={`/briefing?maker=${encodeURIComponent(productor.id)}&product=${encodeURIComponent(producto.id)}`}
                  >
                    <img
                      class="trabajo__foto"
                      src={producto.foto}
                      alt={producto.nombre}
                      loading="lazy"
                    />
                    <div class="trabajo__cuerpo">
                      <h3 class="trabajo__nombre">{producto.nombre}</h3>
                      <div class="trabajo__ficha">
                        <div>
                          <span>Material</span>
                          <span>
                            {MATERIALES[producto.material]?.label ?? producto.material}
                          </span>
                        </div>
                        <div>
                          <span>Medidas</span>
                          <span>{producto.dimensiones}</span>
                        </div>
                        <div>
                          <span>Impresión</span>
                          <span>{producto.tiempoImpresionHoras} h</span>
                        </div>
                      </div>
                      <p class="trabajo__precio">
                        Desde {producto.precioDesde.toFixed(2)} €
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            )
          }

          <h2 class="ficha__seccion-titulo">Opiniones de clientes</h2>
          {
            opiniones.length === 0 ? (
              <p class="ficha__vacio">
                Aún no hay opiniones publicadas. Si ya le has encargado algo,
                puedes ser el primero en contarlo.
              </p>
            ) : (
              <div class="opiniones">
                {opiniones.map((opinion) => (
                  <article class="opinion">
                    <span class="opinion__autor">{opinion.autor}</span>
                    <span class="opinion__estrellas">
                      <Estrellas valor={opinion.valoracion} />
                    </span>
                    <span class="opinion__fecha dato">{opinion.fecha}</span>
                    <p class="opinion__texto">{opinion.comentario}</p>
                  </article>
                ))}
              </div>
            )
          }

          <div class="opinar" data-review-success hidden>
            <p class="opinar__titulo">Gracias por contarlo</p>
            <p class="ficha__bio">
              Revisamos la opinión y la publicamos en el perfil en unos días.
            </p>
          </div>

          <form
            class="opinar"
            data-review-form
            data-productor-id={productor.id}
            data-productor-nombre={productor.nombre}
            data-endpoint={FORMSPREE_RESENAS_ENDPOINT}
          >
            <h2 class="opinar__titulo">Deja tu opinión sobre {productor.nombre}</h2>

            <div class="opinar__campo campo">
              <label class="campo__nombre" for="autor">Tu nombre</label>
              <input class="entrada" id="autor" name="autor" type="text" required maxlength="60" />
            </div>

            <div class="opinar__campo campo">
              <label class="campo__nombre" for="valoracion">Valoración</label>
              <select class="entrada" id="valoracion" name="valoracion" required>
                <option value="5" selected>★★★★★ Excelente</option>
                <option value="4">★★★★☆ Muy bueno</option>
                <option value="3">★★★☆☆ Correcto</option>
                <option value="2">★★☆☆☆ Regular</option>
                <option value="1">★☆☆☆☆ Malo</option>
              </select>
            </div>

            <div class="opinar__campo campo">
              <label class="campo__nombre" for="comentario">Comentario</label>
              <textarea
                class="entrada"
                id="comentario"
                name="comentario"
                rows="4"
                required
                maxlength="500"></textarea>
            </div>

            <button class="boton boton--principal opinar__enviar" type="submit" data-review-submit>
              Enviar opinión
            </button>

            <p class="opinar__nota opinar__nota--error" data-review-error hidden role="alert"></p>
            <p class="opinar__nota">
              La revisamos antes de publicarla, para evitar spam y opiniones
              falsas.
            </p>
          </form>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .ficha__volver {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--tinta-suave);
    text-decoration: none;
  }

  .ficha__volver:hover {
    color: var(--tinta);
    text-decoration: underline;
  }

  .ficha__tecnica div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--linea);
  }

  .ficha__tecnica dt {
    color: var(--tinta-suave);
    white-space: nowrap;
  }

  .ficha__tecnica dd {
    margin: 0;
    text-align: right;
    color: var(--tinta);
  }

  .opinar__enviar {
    margin-top: 1.25rem;
  }
</style>

<script>
  const formulario = document.querySelector("[data-review-form]");
  const exito = document.querySelector("[data-review-success]");
  const error = document.querySelector("[data-review-error]");
  const enviar = document.querySelector("[data-review-submit]");

  formulario?.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    if (!enviar || !error || !exito) return;

    enviar.disabled = true;
    enviar.textContent = "Enviando…";
    error.hidden = true;

    const datos = new FormData(formulario);
    datos.append("productorId", formulario.dataset.productorId || "");
    datos.append("productorNombre", formulario.dataset.productorNombre || "");
    datos.append("tipo", "resena");

    try {
      const respuesta = await fetch(formulario.dataset.endpoint || "", {
        method: "POST",
        body: datos,
        headers: { Accept: "application/json" },
      });
      if (!respuesta.ok) throw new Error("Error al enviar");
      formulario.hidden = true;
      exito.hidden = false;
      exito.scrollIntoView({ behavior: "smooth", block: "center" });
    } catch (fallo) {
      error.textContent =
        "No se pudo enviar la opinión. Vuelve a intentarlo en un momento.";
      error.hidden = false;
    } finally {
      enviar.disabled = false;
      enviar.textContent = "Enviar opinión";
    }
  });
</script>
