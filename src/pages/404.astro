---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada">
  <main class="perdido">
    <div class="envoltura--angosta">
      <p class="etiqueta etiqueta--marca">Error 404</p>
      <h1 class="perdido__titulo">Esta página no existe</h1>
      <p class="perdido__texto">
        O ha cambiado de sitio, o el enlace venía mal. Desde aquí puedes seguir:
      </p>
      <ul class="perdido__salidas">
        <li><a href="/">Inicio</a></li>
        <li><a href="/briefing">Pedir una pieza</a></li>
        <li><a href="/productores">Ver los makers</a></li>
        <li><a href="/maker">Darme de alta como maker</a></li>
      </ul>
    </div>
  </main>
</BaseLayout>

<style>
  .perdido {
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem);
  }

  .perdido__titulo {
    margin-top: 0.8rem;
    font-size: var(--paso-3);
  }

  .perdido__texto {
    margin-top: 1rem;
    color: var(--tinta-media);
  }

  .perdido__salidas {
    margin-top: 1.75rem;
    border-top: 1px solid var(--linea);
  }

  .perdido__salidas li {
    border-bottom: 1px solid var(--linea);
  }

  .perdido__salidas a {
    display: block;
    padding: 0.9rem 0;
    font-weight: 600;
    text-decoration: none;
  }

  .perdido__salidas a:hover {
    text-decoration: underline;
    text-decoration-color: var(--filamento);
    text-decoration-thickness: 2px;
  }
</style>
