---
import BaseLayout from "../layouts/BaseLayout.astro";
import { EXPERIENCIAS, FUNCIONES_SUPABASE } from "../lib/makerShared.js";
import "../styles/AltaMaker.css";

const ventajas = [
  { titulo: "Sin cuota mensual.", texto: "Solo pagas comisión cuando entregas un pedido." },
  { titulo: "Encargos de tu zona.", texto: "Te llegan filtrados por cercanía." },
  { titulo: "Tú decides.", texto: "Aceptas solo los encargos que te encajan." },
];

const SUPABASE_MAKERS_ENDPOINT = `${FUNCIONES_SUPABASE}/register-maker`;
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout
  title="Darme de alta como maker"
  descripcion="Da de alta tu impresora 3D en 3dbok: recibes encargos de tu zona, eliges cuáles aceptas y solo pagas comisión cuando entregas."
>
  <main class="alta">
    <section class="alta__portada en-cianotipo">
      <div class="envoltura alta__portada-interior">
        <header class="alta__presentacion">
          <p class="etiqueta">Para makers</p>
          <h1 class="alta__titulo">Que tu impresora trabaje también para otros</h1>
          <p class="alta__entrada">
            Te llegan encargos de gente de tu zona y decides cuáles coges. Sin
            cuota mensual: solo una comisión cuando entregas la pieza.
          </p>
          <a href="#alta-maker" class="boton boton--arena alta__empezar">Empezar el alta</a>
        </header>

        <!-- Ejemplo de cómo llega un encargo: un correo con lo justo para decidir. -->
        <figure class="aviso">
          <div class="aviso__correo" aria-hidden="true">
            <p class="aviso__cabecera">
              <span class="aviso__punto"></span>
              Encargo nuevo cerca de ti
              <span class="aviso__distancia">a 3 km</span>
            </p>
            <p class="aviso__pieza">Rueda de carro de la compra</p>
            <dl class="aviso__datos">
              <div><dt>Material</dt><dd>PETG negro</dd></div>
              <div><dt>Medidas</dt><dd class="dato">Ø62 × 18 mm</dd></div>
              <div><dt>Boceto</dt><dd>Aprobado por el cliente</dd></div>
            </dl>
            <p class="aviso__pie">Respondes al correo si lo quieres. Si no, lo dejas pasar.</p>
          </div>
          <figcaption class="aviso__leyenda">Así te llega un encargo (ejemplo).</figcaption>
        </figure>
      </div>

      <div class="envoltura alta__ventajas" id="ventajas">
        <h2 class="alta__ventajas-titulo">¿Qué te ofrecemos?</h2>
        <ul class="alta__ventajas-lista">
          {
            ventajas.map((ventaja) => (
              <li>
                <strong>{ventaja.titulo}</strong> {ventaja.texto}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="alta__registro">
      <form
        id="alta-maker"
        class="envoltura alta__formulario"
        data-signup-form
        data-endpoint={SUPABASE_MAKERS_ENDPOINT}
        novalidate
      >
        <aside class="alta__guia" aria-labelledby="alta-guia-titulo">
          <div class="alta__cabeza-guia">
            <!-- Una pieza que se imprime capa a capa. -->
            <svg class="pila pila--fase-1" viewBox="0 0 32 32" aria-hidden="true">
              <rect width="32" height="32" rx="7.5" class="pila__placa"></rect>
              <rect x="6.5" y="20" width="19" height="4" rx="1.2" class="pila__capa pila__capa--1"></rect>
              <rect x="8.5" y="14" width="15" height="4" rx="1.2" class="pila__capa pila__capa--2"></rect>
              <rect x="10.5" y="8" width="11" height="4" rx="1.2" class="pila__capa pila__capa--3"></rect>
            </svg>
            <div>
              <p class="alta__guia-titulo" id="alta-guia-titulo">Tu alta, capa a capa</p>
              <p class="alta__avance-datos">Te lleva un minuto.</p>
            </div>
          </div>

          <p class="alta__garantia">
            Revisamos cada alta a mano antes de mandarte encargos.
          </p>
        </aside>

        <div class="alta__panel">
          <h2 class="alta__seccion">Tus datos</h2>
          <p class="alta__ayuda">
            Con esto revisamos tu alta y te contamos los siguientes pasos por
            email.
          </p>

          <div class="alta__campos">
            <div class="alta__dupla">
              <div class="campo">
                <label class="campo__nombre" for="alta-nombre">Nombre</label>
                <input
                  class="entrada"
                  id="alta-nombre"
                  data-signup-input="name"
                  name="name"
                  type="text"
                  autocomplete="given-name"
                  maxlength="80"
                  placeholder="Tu nombre"
                />
              </div>
              <div class="campo">
                <label class="campo__nombre" for="alta-apellidos">Apellidos</label>
                <input
                  class="entrada"
                  id="alta-apellidos"
                  data-signup-input="lastName"
                  name="lastName"
                  type="text"
                  autocomplete="family-name"
                  maxlength="120"
                  placeholder="Tus apellidos"
                />
              </div>
            </div>

            <div>
              <div class="alta__dupla alta__dupla--estrecha">
                <div class="campo">
                  <label class="campo__nombre" for="alta-cp">Código postal</label>
                  <input
                    class="entrada dato"
                    id="alta-cp"
                    data-signup-input="postalCode"
                    name="postalCode"
                    type="text"
                    inputmode="numeric"
                    autocomplete="postal-code"
                    maxlength="5"
                    pattern="[0-9]{5}"
                    placeholder="29001"
                    aria-describedby="alta-cp-nota"
                  />
                </div>
                <div class="campo">
                  <label class="campo__nombre" for="alta-ciudad" data-ciudad-etiqueta>Ciudad</label>
                  <!-- La ciudad que se envía siempre es este campo. Si el código postal
                       tiene varias localidades, se oculta y se elige en el desplegable. -->
                  <input
                    class="entrada"
                    id="alta-ciudad"
                    data-signup-input="city"
                    name="city"
                    type="text"
                    autocomplete="address-level2"
                    maxlength="120"
                    readonly
                    placeholder="Sale de tu código postal"
                    aria-describedby="alta-cp-nota"
                  />
                  <select
                    class="entrada"
                    id="alta-ciudad-opciones"
                    data-ciudad-opciones
                    aria-describedby="alta-cp-nota"
                    hidden
                  ></select>
                </div>
              </div>
              <p class="alta__nota-campo" id="alta-cp-nota" data-cp-nota aria-live="polite">
                Solo España. La ciudad se rellena sola para que compruebes el código.
              </p>
            </div>

            <div class="campo">
              <label class="campo__nombre" for="alta-email">Email</label>
              <input
                class="entrada"
                id="alta-email"
                data-signup-input="email"
                name="email"
                type="email"
                autocomplete="email"
                maxlength="254"
                placeholder="tu@email.com"
              />
            </div>

            <fieldset class="campo alta__grupo">
              <legend class="campo__nombre">Cuánto llevas imprimiendo en 3D</legend>
              <div class="alta__opciones">
                {
                  EXPERIENCIAS.map((experiencia) => (
                    <button
                      class="opcion"
                      type="button"
                      data-experience={experiencia}
                      aria-pressed="false"
                    >
                      <span class="opcion__titulo">{experiencia}</span>
                    </button>
                  ))
                }
              </div>
            </fieldset>
          </div>

          <p class="alta__privacidad">
            Usaremos estos datos para revisar tu alta y contactarte. Se envían
            y almacenan en una región europea de Supabase; no se crea
            automáticamente una cuenta ni un perfil público. Para mostrarte tu
            ciudad, el código postal (solo el código) se consulta en
            Zippopotam.us. Cloudflare Turnstile comprueba que el envío no sea
            automatizado sin acceder a los campos del formulario. Consulta la
            <a href="/privacidad">política de privacidad</a>.
          </p>

          <div
            class="alta__turnstile"
            data-turnstile
            data-sitekey={TURNSTILE_SITE_KEY}
            aria-label="Verificación de seguridad"
          ></div>

          <p class="alta__error" data-signup-error hidden role="alert" tabindex="-1"></p>

          <div class="alta__pie">
            <p class="alta__requisito">
              Necesitamos nombre, apellidos, un código postal válido, email y experiencia.
            </p>
            <div class="alta__acciones">
              <button class="boton boton--principal" data-signup-submit type="submit" disabled>
                Darme de alta
              </button>
            </div>
          </div>
        </div>
      </form>

      <section class="envoltura alta__exito" data-signup-success hidden>
        <p class="etiqueta">Alta recibida</p>
        <h2 class="alta__titulo" data-success-title tabindex="-1">Te escribimos en unos días</h2>
        <p class="alta__texto">
          Repasamos tu alta y te contamos los siguientes pasos por email.
        </p>
        <p class="alta__texto">
          Si no ves nada, mira en spam o escríbenos a
          <a href="mailto:contacto@3dbok.com">contacto@3dbok.com</a>.
        </p>
        <a href="/" class="boton boton--principal alta__accion">Volver al inicio</a>
      </section>
    </section>
  </main>
</BaseLayout>

<style>
  /* --- Portada -------------------------------------------------------- */
  /* El formulario y su lateral están en src/styles/AltaMaker.css. */

  .alta__portada {
    position: relative;
    overflow: hidden;
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .alta__portada::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgb(252 252 249 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(252 252 249 / 0.07) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
    pointer-events: none;
  }

  .alta__portada-interior {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    padding-block: clamp(3.5rem, 2rem + 5vw, 6rem) clamp(2.5rem, 4vw, 4rem);
  }

  .alta__entrada {
    max-width: 42ch;
    margin-top: 1.4rem;
    font-size: var(--paso-1);
    line-height: 1.55;
    color: rgb(252 252 249 / 0.84);
  }

  .alta__empezar {
    margin-top: 2rem;
  }

  /* El aviso de encargo: un correo de muestra que entra como entraría en
     la bandeja de un maker. */
  .aviso {
    margin: 0;
    justify-self: end;
    width: min(100%, 26rem);
  }

  .aviso__correo {
    padding: 1.25rem 1.35rem 1.1rem;
    border-radius: var(--r-3);
    background: var(--pieza);
    color: var(--tinta);
    box-shadow: 0 24px 50px -28px rgb(23 26 51 / 0.7);
  }

  .aviso__cabecera {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--linea);
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--cianotipo-hondo);
  }

  .aviso__punto {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--filamento);
  }

  .aviso__distancia {
    margin-left: auto;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--cianotipo-lavado);
    font-size: 0.78rem;
  }

  .aviso__pieza {
    margin-top: 0.9rem;
    font-family: var(--fuente-titulo);
    font-size: var(--paso-2);
    font-stretch: 112%;
    font-weight: 720;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .aviso__datos {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }

  .aviso__datos div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
    font-size: 0.92rem;
  }

  .aviso__datos dt {
    color: var(--tinta-suave);
  }

  .aviso__datos dd {
    margin: 0;
    font-weight: 600;
  }

  .aviso__pie {
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--linea);
    font-size: 0.88rem;
    color: var(--tinta-media);
  }

  .aviso__leyenda {
    margin-top: 0.75rem;
    font-size: 0.84rem;
    color: rgb(252 252 249 / 0.72);
  }

  @media (prefers-reduced-motion: no-preference) {
    .aviso__correo {
      animation: llegar-aviso 0.8s var(--curva-muelle) 0.35s both;
    }

    .aviso__punto {
      animation: latir 1.8s ease-in-out 1.2s 3;
    }

    .alta__presentacion > * {
      animation: subir 600ms var(--curva-salida) both;
    }

    .alta__presentacion > :nth-child(2) {
      animation-delay: 60ms;
    }

    .alta__presentacion > :nth-child(3) {
      animation-delay: 120ms;
    }

    .alta__presentacion > :nth-child(4) {
      animation-delay: 180ms;
    }
  }

  @keyframes llegar-aviso {
    from {
      opacity: 0;
      transform: translateY(28px) rotate(2.5deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes latir {
    50% {
      box-shadow: 0 0 0 6px rgb(229 89 47 / 0.25);
    }
  }

  @keyframes subir {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .alta__ventajas {
    position: relative;
  }

  .alta__ventajas-titulo {
    margin: 0 0 0.9rem;
    font-size: var(--paso-2);
  }

  .alta__ventajas-lista {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--linea-clara);
    font-size: 0.93rem;
    line-height: 1.5;
    color: rgb(252 252 249 / 0.76);
  }

  .alta__ventajas-lista li {
    padding: 1.1rem 1.5rem 0 0;
  }

  .alta__ventajas-lista li + li {
    padding-left: 1.5rem;
    border-left: 1px solid var(--linea-clara);
  }

  .alta__ventajas strong {
    display: block;
    font-weight: 650;
    color: var(--pieza);
  }

  @media (max-width: 880px) {
    .alta__portada-interior {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .aviso {
      justify-self: start;
    }
  }

  @media (max-width: 720px) {
    .alta__ventajas-lista {
      grid-template-columns: minmax(0, 1fr);
    }

    .alta__ventajas-lista li,
    .alta__ventajas-lista li + li {
      padding: 0.85rem 0;
      border-left: 0;
    }

    .alta__ventajas-lista li + li {
      border-top: 1px solid var(--linea-clara);
    }
  }
</style>

<script
  is:inline
  data-turnstile-script
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
  async
  defer
></script>

<script>
  import { CODIGO_POSTAL, buscarLocalidades, normalizarTexto } from "../lib/makerShared.js";
  import { prepararTurnstile } from "../lib/turnstile.js";

  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const TEXTO_ENVIAR = "Darme de alta";
  const NOTA_CP_INICIAL =
    "Solo España. La ciudad se rellena sola para que compruebes el código.";

  const formulario = document.querySelector("[data-signup-form]");
  const exito = document.querySelector("[data-signup-success]");
  const error = document.querySelector("[data-signup-error]");
  const enviar = document.querySelector("[data-signup-submit]");
  const entradas = Array.from(document.querySelectorAll("[data-signup-input]"));
  const campoCp = document.querySelector('[data-signup-input="postalCode"]');
  const campoCiudad = document.querySelector('[data-signup-input="city"]');
  const opcionesCiudad = document.querySelector("[data-ciudad-opciones]");
  const etiquetaCiudad = document.querySelector("[data-ciudad-etiqueta]");
  const notaCp = document.querySelector("[data-cp-nota]");
  const botonesExperiencia = Array.from(document.querySelectorAll("[data-experience]"));
  const tituloExito = document.querySelector("[data-success-title]");
  const turnstile = prepararTurnstile(
    document.querySelector("[data-turnstile]"),
    document.querySelector("[data-turnstile-script]"),
  );

  const marcado = (boton) => boton.getAttribute("aria-pressed") === "true";

  const valor = (clave) => {
    const campo = document.querySelector(`[data-signup-input="${clave}"]`);
    return campo instanceof HTMLInputElement ? campo.value.trim() : "";
  };

  // Búsqueda de la ciudad en curso; mientras dura no se puede enviar.
  let busquedaCp = null;

  const formularioValido = () =>
    Boolean(
      valor("name") &&
        valor("lastName") &&
        CODIGO_POSTAL.test(valor("postalCode")) &&
        valor("city") &&
        EMAIL.test(valor("email")) &&
        botonesExperiencia.some(marcado) &&
        !busquedaCp,
    );

  const actualizarBoton = () => {
    if (enviar instanceof HTMLButtonElement) enviar.disabled = !formularioValido();
  };

  const avisarCp = (texto, tono) => {
    if (!(notaCp instanceof HTMLElement) || !(campoCp instanceof HTMLInputElement)) return;
    notaCp.textContent = texto;
    if (tono) notaCp.dataset.tono = tono;
    else delete notaCp.dataset.tono;
    if (tono === "error") campoCp.setAttribute("aria-invalid", "true");
    else campoCp.removeAttribute("aria-invalid");
  };

  // Si Zippopotam no responde, la ciudad se escribe a mano para no bloquear el alta.
  const ciudadAMano = (aMano) => {
    if (!(campoCiudad instanceof HTMLInputElement)) return;
    campoCiudad.readOnly = !aMano;
    campoCiudad.placeholder = aMano ? "Escribe tu ciudad" : "Sale de tu código postal";
  };

  // Con varias localidades en un mismo código postal, el campo de ciudad se
  // sustituye por un desplegable. El valor elegido se copia al campo, que es
  // el que se envía; sin sugerida, el maker tiene que elegir.
  const mostrarDesplegable = (localidades, sugerida) => {
    if (!(opcionesCiudad instanceof HTMLSelectElement) || !(campoCiudad instanceof HTMLInputElement)) return;

    const indicacion = new Option(`Elige tu localidad (${localidades.length})`, "", !sugerida, !sugerida);
    indicacion.disabled = true;
    opcionesCiudad.replaceChildren(
      indicacion,
      ...localidades.map((localidad) => new Option(localidad, localidad, false, localidad === sugerida)),
    );

    campoCiudad.value = opcionesCiudad.value;
    campoCiudad.hidden = true;
    opcionesCiudad.hidden = false;
    if (etiquetaCiudad instanceof HTMLLabelElement) etiquetaCiudad.htmlFor = opcionesCiudad.id;
  };

  const ocultarDesplegable = () => {
    if (!(opcionesCiudad instanceof HTMLSelectElement) || !(campoCiudad instanceof HTMLInputElement)) return;
    opcionesCiudad.replaceChildren();
    opcionesCiudad.hidden = true;
    campoCiudad.hidden = false;
    if (etiquetaCiudad instanceof HTMLLabelElement) etiquetaCiudad.htmlFor = campoCiudad.id;
  };

  const comprobarCodigoPostal = async () => {
    if (!(campoCp instanceof HTMLInputElement) || !(campoCiudad instanceof HTMLInputElement)) return;

    const codigo = campoCp.value.replace(/\D/g, "").slice(0, 5);
    if (campoCp.value !== codigo) campoCp.value = codigo;

    busquedaCp?.abort();
    busquedaCp = null;
    campoCiudad.value = "";
    ciudadAMano(false);
    ocultarDesplegable();

    if (codigo.length < 5) {
      avisarCp(NOTA_CP_INICIAL);
      actualizarBoton();
      return;
    }
    if (!CODIGO_POSTAL.test(codigo)) {
      avisarCp("Ese código postal no existe en España. Revísalo.", "error");
      actualizarBoton();
      return;
    }

    const controlador = new AbortController();
    busquedaCp = controlador;
    avisarCp("Buscando tu localidad…");
    actualizarBoton();

    try {
      const resultado = await buscarLocalidades(codigo, { signal: controlador.signal });
      if (controlador.signal.aborted) return;
      if (!resultado) {
        avisarCp("No encontramos ese código postal. Revísalo.", "error");
      } else if (resultado.localidades.length === 1) {
        campoCiudad.value = resultado.localidades[0];
        avisarCp("¿Es tu localidad? Si no, revisa el código postal.");
      } else {
        mostrarDesplegable(resultado.localidades, resultado.sugerida);
        avisarCp(
          resultado.sugerida
            ? `Este código postal incluye ${resultado.localidades.length} localidades. Comprueba que la elegida es la tuya.`
            : `Este código postal incluye ${resultado.localidades.length} localidades. Elige la tuya.`,
        );
      }
    } catch {
      if (controlador.signal.aborted) return;
      ciudadAMano(true);
      avisarCp("No hemos podido comprobar el código postal. Escribe tu ciudad a mano.");
    } finally {
      if (busquedaCp === controlador) busquedaCp = null;
      actualizarBoton();
    }
  };

  entradas.forEach((entrada) => entrada.addEventListener("input", actualizarBoton));
  campoCp?.addEventListener("input", comprobarCodigoPostal);
  opcionesCiudad?.addEventListener("change", () => {
    if (campoCiudad instanceof HTMLInputElement && opcionesCiudad instanceof HTMLSelectElement) {
      campoCiudad.value = opcionesCiudad.value;
    }
    actualizarBoton();
  });

  botonesExperiencia.forEach((boton) => {
    boton.addEventListener("click", () => {
      botonesExperiencia.forEach((otro) => otro.setAttribute("aria-pressed", "false"));
      boton.setAttribute("aria-pressed", "true");
      actualizarBoton();
    });
  });

  formulario?.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    if (!(enviar instanceof HTMLButtonElement) || enviar.disabled) return;
    if (!(formulario instanceof HTMLFormElement) || !exito || !(error instanceof HTMLElement)) return;
    if (!formularioValido()) return;

    enviar.disabled = true;
    enviar.textContent = "Enviando…";
    error.hidden = true;
    formulario.setAttribute("aria-busy", "true");

    const datos = new FormData(formulario);
    // Texto libre en mayúsculas y sin tildes; email y experiencia van tal cual.
    ["name", "lastName", "city"].forEach((clave) => datos.set(clave, normalizarTexto(valor(clave))));
    datos.set("experience", botonesExperiencia.find(marcado)?.dataset.experience || "");

    try {
      const respuesta = await fetch(formulario.dataset.endpoint || "", {
        method: "POST",
        body: datos,
        headers: { Accept: "application/json" },
      });
      if (!respuesta.ok) throw new Error("Error al enviar");

      formulario.removeAttribute("aria-busy");
      formulario.hidden = true;
      exito.hidden = false;
      exito.scrollIntoView({
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth",
        block: "start",
      });
      if (tituloExito instanceof HTMLElement) tituloExito.focus({ preventScroll: true });
    } catch {
      turnstile.reiniciar();
      formulario.removeAttribute("aria-busy");
      enviar.textContent = TEXTO_ENVIAR;
      actualizarBoton();
      error.textContent =
        "No se ha podido enviar el alta. Compruébalo y vuelve a intentarlo.";
      error.hidden = false;
      error.focus();
    }
  });

  actualizarBoton();
</script>
