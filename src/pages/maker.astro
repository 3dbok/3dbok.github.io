    .alta__garantia {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .alta__ventajas {
      grid-template-columns: minmax(0, 1fr);
    }

    .alta__ventajas li,
    .alta__ventajas li + li {
      padding: 0.85rem 0;
      border-left: 0;
    }

    .alta__ventajas li + li {
      border-top: 1px solid var(--linea-clara);
    }
  }

  @media (max-width: 560px) {
    .alta__registro {
      padding-block: 1.5rem 3rem;
    }

    .alta__indicador-titulo {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .alta__pasos {
      display: flex;
      gap: 0.5rem;
    }

    .alta__panel {
      padding: 1.25rem 1.1rem;
    }

    .alta__seccion {
      margin-bottom: 1.2rem;
      font-size: clamp(1.8rem, 8.5vw, 2.3rem);
    }

    .alta__campos {
      gap: 1.65rem;
    }

    .alta__dupla {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.65rem;
    }

    .alta__pie {
      flex-direction: column;
      align-items: stretch;
    }

    .alta__requisito {
