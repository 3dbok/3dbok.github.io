---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Pedido enviado"
  descripcion="Resumen de tu pedido en 3dbok y qué pasa a partir de ahora."
>
  <main class="acuse">
    <div class="envoltura--angosta">
      <section class="acuse__vacio" data-no-order>
        <h1 class="acuse__titulo">Aquí no hay ningún pedido</h1>
        <p class="acuse__texto">
          Este resumen solo aparece justo después de enviar un pedido. Si venías
          a hacer uno, se empieza aquí.
        </p>
        <a href="/briefing" class="boton boton--principal acuse__accion">
          Pedir una pieza <span class="boton__flecha" aria-hidden="true">→</span>
        </a>
      </section>

      <div data-order-confirmation hidden>
        <p class="etiqueta etiqueta--marca">Pedido enviado</p>
        <h1 class="acuse__titulo">Ya lo tenemos</h1>
        <p class="acuse__texto">
          Te hemos escrito a <strong data-order-email>tu email</strong> con esta
          misma información.
        </p>

        <div class="acuse__resguardo">
          <div class="acuse__cabecera">
            <div>
              <p class="etiqueta">Referencia</p>
              <p class="acuse__referencia dato" data-order-id></p>
            </div>
            <span class="acuse__estado dato">Pendiente de boceto</span>
          </div>

          <dl class="acuse__detalle dato">
            <div data-row="maker">
              <dt>Maker</dt>
              <dd data-order-maker></dd>
            </div>
            <div data-row="size">
              <dt>Tamaño</dt>
              <dd data-order-size></dd>
            </div>
            <div data-row="material">
              <dt>Material</dt>
              <dd data-order-material></dd>
            </div>
            <div data-row="deadline" hidden>
              <dt>Fecha deseada</dt>
              <dd data-order-deadline></dd>
            </div>
            <div data-row="budget" hidden>
              <dt>Presupuesto</dt>
              <dd data-order-budget></dd>
            </div>
          </dl>

          <div class="acuse__descripcion">
            <p class="etiqueta">Lo que nos has contado</p>
            <p class="acuse__cita" data-order-description></p>
          </div>
        </div>

        <section class="acuse__siguiente">
          <h2 class="acuse__subtitulo">Qué pasa ahora</h2>
          {/* Las dos secuencias van escritas: la de JS no heredaría los
              estilos con ámbito de esta página. */}
          <ol class="acuse__pasos" data-steps="idea">
            <li>Un diseñador lee tu descripción y empieza el boceto</li>
            <li>Te enviamos el boceto para que lo apruebes o pidas cambios</li>
            <li>Ves fotos del proceso mientras se imprime</li>
            <li>Recibes la pieza en la dirección que nos digas</li>
          </ol>
          <ol class="acuse__pasos" data-steps="diseno" hidden>
            <li>Buscamos un maker disponible cerca de ti</li>
            <li>El maker confirma el encargo y el precio final</li>
            <li>Ves fotos del proceso mientras se imprime</li>
            <li>Recibes la pieza en la dirección que nos digas</li>
          </ol>
        </section>

        <div class="acuse__pie">
          <a href="/" class="boton boton--secundario">Volver al inicio</a>
          <p class="acuse__aviso dato">
            ¿Algo no cuadra? Escríbenos a <a href="mailto:contacto@3dbok.com"
              >contacto@3dbok.com</a
            >
          </p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .acuse {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .acuse__titulo {
    margin-top: 0.75rem;
    font-size: var(--paso-3);
  }

  .acuse__vacio .acuse__titulo {
    margin-top: 0;
  }

  .acuse__texto {
    margin-top: 0.9rem;
    color: var(--tinta-media);
    line-height: 1.6;
  }

  .acuse__accion {
    margin-top: 1.75rem;
  }

  .acuse__resguardo {
    margin-top: 2rem;
    border: 1px solid var(--linea);
    border-radius: var(--r-3);
    background: var(--pieza);
    overflow: hidden;
  }

  .acuse__cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    border-bottom: 1px solid var(--linea);
  }

  .acuse__referencia {
    margin-top: 0.3rem;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .acuse__estado {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--cianotipo-lavado);
    color: var(--cianotipo-hondo);
    font-weight: 600;
  }

  .acuse__detalle {
    padding: 0.5rem 1.4rem;
  }

  .acuse__detalle > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--linea);
  }

  .acuse__detalle > div:last-child {
    border-bottom: 0;
  }

  .acuse__detalle dt {
    color: var(--tinta-suave);
  }

  .acuse__detalle dd {
    margin: 0;
    text-align: right;
  }

  .acuse__descripcion {
    padding: 1.2rem 1.4rem 1.4rem;
    border-top: 1px solid var(--linea);
    background: var(--bancada);
  }

  .acuse__cita {
    margin-top: 0.5rem;
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--tinta-media);
  }

  .acuse__siguiente {
    margin-top: 2.25rem;
  }

  .acuse__subtitulo {
    font-size: var(--paso-1);
  }

  .acuse__pasos {
    margin-top: 1rem;
    counter-reset: fase;
  }

  .acuse__pasos li {
    position: relative;
    counter-increment: fase;
    padding: 0.7rem 0 0.7rem 2.5rem;
    border-bottom: 1px solid var(--linea);
    font-size: 0.95rem;
    color: var(--tinta-media);
  }

  .acuse__pasos li::before {
    content: counter(fase, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.95rem;
    font-family: var(--fuente-dato);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--filamento-tinta);
  }

  .acuse__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .acuse__aviso {
    color: var(--tinta-suave);
  }
</style>

<script>
  const etiquetasTamano = {
    xs: "Pequeño · menos de 5 cm",
    s: "Compacto · 5 – 15 cm",
    m: "Mediano · 15 – 30 cm",
    l: "Grande · más de 30 cm",
  };

  const etiquetasMaterial = {
    any: "Lo elige el maker",
    pla: "PLA",
    resin: "Resina",
    petg: "PETG",
  };

  const sinPedido = document.querySelector("[data-no-order]");
  const resumen = document.querySelector("[data-order-confirmation]");
  const guardado = sessionStorage.getItem("3dbok-pedido");
  const pedido = guardado ? JSON.parse(guardado) : null;

  if (pedido && sinPedido && resumen) {
    sinPedido.hidden = true;
    resumen.hidden = false;

    const escribir = (selector, texto) => {
      const nodo = document.querySelector(selector);
      if (nodo) nodo.textContent = texto || "";
    };

    const mostrarFila = (nombre, texto) => {
      const fila = document.querySelector(`[data-row="${nombre}"]`);
      if (fila) fila.hidden = !texto;
    };

    escribir("[data-order-email]", pedido.email || "tu email");
    escribir("[data-order-id]", pedido.orderId);
    escribir("[data-order-maker]", pedido.makerNombre || "Lo elegimos nosotros");
    escribir("[data-order-size]", etiquetasTamano[pedido.size] || pedido.size);
    escribir(
      "[data-order-material]",
      etiquetasMaterial[pedido.material] || pedido.material,
    );
    escribir("[data-order-description]", pedido.description);

    if (pedido.deadline) {
      const fecha = new Date(`${pedido.deadline}T00:00:00`);
      escribir(
        "[data-order-deadline]",
        fecha.toLocaleDateString("es-ES", {
          day: "numeric",
          month: "long",
          year: "numeric",
        }),
      );
      mostrarFila("deadline", true);
    }

    if (pedido.budget) {
      escribir("[data-order-budget]", pedido.budget);
      mostrarFila("budget", true);
    }

    const secuencia = pedido.hasDesign ? "diseno" : "idea";
    document.querySelectorAll("[data-steps]").forEach((lista) => {
      lista.hidden = lista.dataset.steps !== secuencia;
    });
  }
</script>
