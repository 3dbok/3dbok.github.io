---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Solicitud recibida"
  descripcion="Confirmación privada de una solicitud enviada a 3dbok."
  noindex
>
  <main class="acuse">
    <div class="envoltura--angosta">
      <section class="acuse__vacio" data-order-loading>
        <h1 class="acuse__titulo">Comprobando la solicitud…</h1>
      </section>

      <section class="acuse__vacio" data-no-order hidden>
        <h1 class="acuse__titulo">Aquí no hay ninguna solicitud reciente</h1>
        <p class="acuse__texto">
          Este resumen solo está disponible durante un tiempo después de enviar
          el formulario desde este navegador.
        </p>
        <a href="/briefing" class="boton boton--principal acuse__accion">
          Pedir una pieza <span class="boton__flecha" aria-hidden="true">→</span>
        </a>
      </section>

      <div data-order-confirmation hidden>
        <p class="etiqueta etiqueta--marca">Solicitud recibida</p>
        <h1 class="acuse__titulo">Ya la tenemos</h1>
        <p class="acuse__texto" data-order-intro>
          Revisaremos la información y te contactaremos en
          <strong data-order-email>tu email</strong>.
        </p>

        <div class="acuse__resguardo">
          <div class="acuse__cabecera">
            <div>
              <p class="etiqueta">Referencia</p>
              <p class="acuse__referencia dato" data-order-id></p>
            </div>
            <span class="acuse__estado dato">Pendiente de revisión</span>
          </div>

          <dl class="acuse__detalle dato" data-order-details>
            <div data-row="maker">
              <dt>Maker</dt>
              <dd data-order-maker></dd>
            </div>
            <div data-row="product" hidden>
              <dt>Trabajo de referencia</dt>
              <dd data-order-product></dd>
            </div>
            <div data-row="size">
              <dt>Tamaño</dt>
              <dd data-order-size></dd>
            </div>
            <div data-row="material">
              <dt>Material</dt>
              <dd data-order-material></dd>
            </div>
            <div data-row="stl" hidden>
              <dt>STL</dt>
              <dd data-order-stl></dd>
            </div>
            <div data-row="deadline" hidden>
              <dt>Fecha deseada</dt>
              <dd data-order-deadline></dd>
            </div>
            <div data-row="budget" hidden>
              <dt>Presupuesto</dt>
              <dd data-order-budget></dd>
            </div>
          </dl>

          <div class="acuse__descripcion" data-order-description-block>
            <p class="etiqueta">Lo que nos has contado</p>
            <p class="acuse__cita" data-order-description></p>
          </div>
        </div>

        <section class="acuse__siguiente" data-order-next-steps>
          <h2 class="acuse__subtitulo">Qué pasa ahora</h2>
          <ol class="acuse__pasos" data-steps="idea">
            <li>Revisamos la descripción y comprobamos qué información falta</li>
            <li>Te contactamos para concretar el diseño y las medidas</li>
            <li>Recibes una propuesta y un precio para que los apruebes</li>
            <li>Solo después coordinamos la producción y la entrega</li>
          </ol>
          <ol class="acuse__pasos" data-steps="diseno" hidden>
            <li>Revisamos los detalles de la solicitud</li>
            <li>Te contactamos por email para pedirte el archivo STL</li>
            <li>Recibes una valoración y un precio para que los apruebes</li>
            <li>Solo después coordinamos la impresión y la entrega</li>
          </ol>
        </section>

        <div class="acuse__pie">
          <a href="/" class="boton boton--secundario">Volver al inicio</a>
          <p class="acuse__aviso dato">
            ¿Algo no cuadra? Escríbenos a <a href="mailto:contacto@3dbok.com"
              >contacto@3dbok.com</a
            >
          </p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .acuse {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .acuse__titulo {
    margin-top: 0.75rem;
    font-size: var(--paso-3);
  }

  .acuse__vacio .acuse__titulo {
    margin-top: 0;
  }

  .acuse__texto {
    margin-top: 0.9rem;
    color: var(--tinta-media);
    line-height: 1.6;
  }

  .acuse__accion {
    margin-top: 1.75rem;
  }

  .acuse__resguardo {
    margin-top: 2rem;
    border: 1px solid var(--linea);
    border-radius: var(--r-3);
    background: var(--pieza);
    overflow: hidden;
  }

  .acuse__cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    border-bottom: 1px solid var(--linea);
  }

  .acuse__referencia {
    margin-top: 0.3rem;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .acuse__estado {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--cianotipo-lavado);
    color: var(--cianotipo-hondo);
    font-weight: 600;
  }

  .acuse__detalle {
    padding: 0.5rem 1.4rem;
  }

  .acuse__detalle > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--linea);
  }

  .acuse__detalle > div:last-child {
    border-bottom: 0;
  }

  .acuse__detalle dt {
    color: var(--tinta-suave);
  }

  .acuse__detalle dd {
    margin: 0;
    text-align: right;
  }

  .acuse__descripcion {
    padding: 1.2rem 1.4rem 1.4rem;
    border-top: 1px solid var(--linea);
    background: var(--bancada);
  }

  .acuse__cita {
    margin-top: 0.5rem;
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--tinta-media);
  }

  .acuse__siguiente {
    margin-top: 2.25rem;
  }

  .acuse__subtitulo {
    font-size: var(--paso-1);
  }

  .acuse__pasos {
    margin-top: 1rem;
    counter-reset: fase;
  }

  .acuse__pasos li {
    position: relative;
    counter-increment: fase;
    padding: 0.7rem 0 0.7rem 2.5rem;
    border-bottom: 1px solid var(--linea);
    font-size: 0.95rem;
    color: var(--tinta-media);
  }

  .acuse__pasos li::before {
    content: counter(fase, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.95rem;
    font-family: var(--fuente-dato);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--filamento-tinta);
  }

  .acuse__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .acuse__aviso {
    color: var(--tinta-suave);
  }
</style>

<script>
  import {
    CONFIRMACION_TTL_MS,
    ETIQUETAS_MATERIAL,
    ETIQUETAS_TAMANO,
    PEDIDO_CONFIRMACION_STORAGE_KEY,
  } from "../lib/pedidoShared.js";

  const cargando = document.querySelector("[data-order-loading]");
  const sinPedido = document.querySelector("[data-no-order]");
  const resumen = document.querySelector("[data-order-confirmation]");

  const leerConfirmacion = () => {
    try {
      const guardado = sessionStorage.getItem(PEDIDO_CONFIRMACION_STORAGE_KEY);
      if (!guardado) return null;
      const pedido = JSON.parse(guardado);
      const valido =
        pedido?.version === 2 &&
        pedido?.status === "submitted" &&
        typeof pedido?.orderId === "string" &&
        /^3DB-[A-Z0-9]{5,12}$/.test(pedido.orderId) &&
        Number.isFinite(pedido?.submittedAt) &&
        Date.now() - pedido.submittedAt <= CONFIRMACION_TTL_MS;

      if (!valido) {
        sessionStorage.removeItem(PEDIDO_CONFIRMACION_STORAGE_KEY);
        return null;
      }
      return pedido;
    } catch {
      return null;
    }
  };

  const referenciaDeRespaldo = new URLSearchParams(window.location.search).get("referencia");
  const referenciaValida =
    typeof referenciaDeRespaldo === "string" && /^3DB-[A-Z0-9]{5,12}$/.test(referenciaDeRespaldo);
  const pedido = leerConfirmacion();

  if (cargando) cargando.hidden = true;

  if ((pedido || referenciaValida) && sinPedido && resumen) {
    sinPedido.hidden = true;
    resumen.hidden = false;

    const escribir = (selector, texto) => {
      const nodo = document.querySelector(selector);
      if (nodo) nodo.textContent = texto || "";
    };

    const mostrarFila = (nombre, texto) => {
      const fila = document.querySelector(`[data-row="${nombre}"]`);
      if (fila) fila.hidden = !texto;
    };

    escribir("[data-order-id]", pedido?.orderId || referenciaDeRespaldo);

    if (!pedido) {
      const introduccion = document.querySelector("[data-order-intro]");
      if (introduccion) {
        introduccion.textContent =
          "La solicitud se envió correctamente, pero este navegador no ha podido conservar el resumen. Guarda la referencia por si necesitas escribirnos.";
      }
      document.querySelector("[data-order-details]")?.setAttribute("hidden", "");
      document.querySelector("[data-order-description-block]")?.setAttribute("hidden", "");
      document.querySelector("[data-order-next-steps]")?.setAttribute("hidden", "");
    } else {
      escribir("[data-order-email]", pedido.email || "tu email");
      escribir("[data-order-maker]", pedido.makerNombre || "Lo elegimos nosotros");
      escribir("[data-order-size]", ETIQUETAS_TAMANO[pedido.size] || pedido.size);
      escribir(
        "[data-order-material]",
        ETIQUETAS_MATERIAL[pedido.material] || pedido.material,
      );
      escribir("[data-order-description]", pedido.description);

      if (pedido.productName) {
        escribir("[data-order-product]", pedido.productName);
        mostrarFila("product", true);
      }

      if (pedido.hasDesign) {
        escribir(
          "[data-order-stl]",
          pedido.stlSelected
            ? "Seleccionado localmente; te lo pediremos por email"
            : "No seleccionado; te lo pediremos por email",
        );
        mostrarFila("stl", true);
      }

      if (pedido.deadline) {
        const fecha = new Date(`${pedido.deadline}T00:00:00`);
        if (!Number.isNaN(fecha.getTime())) {
          escribir(
            "[data-order-deadline]",
            fecha.toLocaleDateString("es-ES", {
              day: "numeric",
              month: "long",
              year: "numeric",
            }),
          );
          mostrarFila("deadline", true);
        }
      }

      if (pedido.budget) {
        escribir("[data-order-budget]", pedido.budget);
        mostrarFila("budget", true);
      }

      const secuencia = pedido.hasDesign ? "diseno" : "idea";
      document.querySelectorAll("[data-steps]").forEach((lista) => {
        lista.hidden = lista.dataset.steps !== secuencia;
      });
    }
  } else if (sinPedido) {
    sinPedido.hidden = false;
  }
</script>
