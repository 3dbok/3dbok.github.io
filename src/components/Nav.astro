---
import Logo from "./Logo.astro";

const ruta = Astro.url.pathname.replace(/\/$/, "") || "/";
const enlaces = [
  { href: "/productores", texto: "Makers" },
  { href: "/maker", texto: "Soy maker" },
];
const activo = (href) => ruta === href || ruta.startsWith(`${href}/`);
---

<header class="cabecera">
  <div class="cabecera__interior envoltura">
    <a href="/" class="cabecera__marca" aria-label="3dbok, ir al inicio">
      <Logo />
    </a>

    <button
      class="cabecera__interruptor"
      type="button"
      data-menu-boton
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      <span class="solo-lectores">Menú</span>
      <svg viewBox="0 0 20 14" width="20" height="14" aria-hidden="true">
        <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.6" />
      </svg>
    </button>

    <nav class="cabecera__menu" id="menu-principal" data-menu aria-label="Principal">
      {
        enlaces.map((enlace) => (
          <a
            href={enlace.href}
            class="cabecera__enlace"
            aria-current={activo(enlace.href) ? "page" : undefined}
          >
            {enlace.texto}
          </a>
        ))
      }
      <a href="/briefing" class="boton boton--principal cabecera__accion">
        Pedir una pieza
      </a>
    </nav>
  </div>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bancada) 88%, transparent);
    border-bottom: 1px solid var(--linea);
    backdrop-filter: blur(12px);
  }

  .cabecera__interior {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 66px;
  }

  .cabecera__marca {
    text-decoration: none;
  }

  .cabecera__menu {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .cabecera__enlace {
    padding: 0.5rem 0.8rem;
    border-radius: var(--r-2);
    color: var(--tinta-media);
    font-size: 0.93rem;
    font-weight: 550;
    text-decoration: none;
    transition: color 0.16s ease, background-color 0.16s ease;
  }

  .cabecera__enlace:hover {
    color: var(--tinta);
    background: rgba(21, 24, 27, 0.05);
  }

  .cabecera__enlace[aria-current="page"] {
    color: var(--tinta);
    box-shadow: inset 0 -2px 0 var(--filamento);
    border-radius: 0;
  }

  .cabecera__accion {
    margin-left: 0.35rem;
    padding: 0.6rem 1.05rem;
    font-size: 0.92rem;
  }

  .cabecera__interruptor {
    display: none;
    padding: 0.6rem;
    border: 1px solid var(--linea-fuerte);
    border-radius: var(--r-2);
    background: none;
    color: var(--tinta);
    cursor: pointer;
  }

  @media (max-width: 720px) {
    .cabecera__interruptor {
      display: inline-flex;
    }

    .cabecera__menu {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--canal) 1.1rem;
      background: var(--bancada);
      border-bottom: 1px solid var(--linea);
    }

    .cabecera__menu[hidden] {
      display: none;
    }

    .cabecera__enlace {
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--linea);
      border-radius: 0;
      font-size: 1rem;
    }

    .cabecera__enlace[aria-current="page"] {
      box-shadow: none;
      color: var(--filamento-tinta);
    }

    .cabecera__accion {
      margin: 0.9rem 0 0;
      justify-content: center;
    }
  }
</style>

<script>
  const boton = document.querySelector("[data-menu-boton]");
  const menu = document.querySelector("[data-menu]");
  const compacto = window.matchMedia("(max-width: 720px)");

  const cerrar = () => {
    if (!menu || !boton) return;
    menu.hidden = compacto.matches;
    boton.setAttribute("aria-expanded", "false");
  };

  boton?.addEventListener("click", () => {
    if (!menu) return;
    const abierto = boton.getAttribute("aria-expanded") === "true";
    menu.hidden = abierto;
    boton.setAttribute("aria-expanded", String(!abierto));
  });

  document.addEventListener("keydown", (evento) => {
    if (evento.key === "Escape") cerrar();
  });

  compacto.addEventListener("change", cerrar);
  cerrar();
</script>
