---
/**
 * La firma de la casa: un boquerón que se imprime de verdad al cargar la
 * portada. Va tumbado sobre la bancada y su sección es una elipse, como la del
 * pez: apoya poco en la cama, ensancha hasta la altura media y se vuelve a
 * cerrar hacia el lomo. Las aletas y la cola son láminas finas que salen justo
 * de esa altura media, así que quedan en el aire y el laminador les pone
 * soporte en árbol: troncos que suben desde la cama y se abren en ramas hasta
 * tocar cada aleta.
 *
 * Sin JavaScript se ve la pieza terminada. Con JavaScript, la boquilla la
 * deposita capa a capa, la lectura de la máquina sube con ella y la bancada
 * se puede girar con el puntero para verla desde otro ángulo.
 *
 * El boquerón no es un adorno: es el bicho de Málaga, de donde sale 3dbok.
 */
import { tonosDePared } from "../lib/capas.js";

const CAPAS = 24;
const CAPA_ALETA = 11; // primera capa de aletas y cola: la altura media
const CAPAS_ALETA = 2; // las aletas son láminas de pocas capas
const ALTURA_CAPA = 1.2; // separación en pantalla entre capa y capa
const MM_POR_CAPA = 0.2; // lo que mide de verdad una capa con boquilla de 0.4
const MEDIO_ALTO = 28; // medio alto del cuerpo en su parte más ancha
const LARGO = 134; // medio largo del cuerpo, del centro al morro
const AFILADO = 2.2; // morro y cola adelgazan más deprisa que el lomo
const CORTE_CAMA = 0.72; // cuánto se ha cortado la elipse por abajo para apoyar
const CORTE_LOMO = 0.85; // y por arriba, para que el lomo no acabe en filo
const CENTRO_X = -16; // centro del cuerpo: cada capa se cierra hacia aquí
const GIRO = -24; // grados de giro sobre la bancada
const APLASTADO = 0.5; // coseno del ángulo de cámara: la vista isométrica

// Silueta del boquerón, centrada en el origen. Morro afilado, aleta dorsal a
// media espalda, anal atrasada y cola muy ahorquillada.
const BOQUERON = `
  M -150 0
  C -138 -12 -124 -19 -108 -22
  C -80 -26 -46 -28 -16 -28
  L -6 -29
  C -2 -41 4 -48 10 -49
  C 14 -43 17 -33 18 -27
  C 46 -25 74 -20 98 -12
  C 106 -9 112 -6 116 -4
  L 150 -36
  C 136 -20 128 -8 126 0
  C 128 8 136 20 150 36
  L 116 4
  C 112 6 106 9 98 13
  C 78 20 62 24 48 26
  L 42 27
  C 40 37 35 44 30 45
  C 27 40 25 32 24 26
  C 0 29 -30 29 -58 26
  C -88 22 -118 14 -138 5
  C -144 3 -148 1 -150 0
  Z
`
  .trim()
  .replace(/\s+/g, " ");

// El mismo pez sin aletas: lo que se imprime por debajo y por encima de ellas.
const CUERPO = `
  M -150 0
  C -138 -12 -124 -19 -108 -22
  C -80 -26 -46 -28 -16 -28
  C 30 -27 74 -20 98 -12
  C 106 -9 112 -6 118 -3
  L 120 0
  L 118 3
  C 112 6 106 9 98 13
  C 62 24 0 29 -58 26
  C -88 22 -118 14 -138 5
  C -144 3 -148 1 -150 0
  Z
`
  .trim()
  .replace(/\s+/g, " ");

// Sección en elipse: `u` recorre el alto de la pieza de -1 (cama) a 1 (lomo)
// y vale 0 en la altura media, donde están las aletas. Cada capa se mete
// hacia dentro lo que pide la elipse en ese punto, más por el morro y la
// cola que por el lomo y el vientre, y conserva la silueta del pez.
const MEDIO = CAPA_ALETA + (CAPAS_ALETA - 1) / 2;
const tonos = tonosDePared(CAPAS, "#6d6643", "#e4ddb2");
const capas = Array.from({ length: CAPAS }, (_, i) => {
  const u = i < MEDIO ? (-CORTE_CAMA * (MEDIO - i)) / MEDIO : (CORTE_LOMO * (i - MEDIO)) / (CAPAS - 1 - MEDIO);
  const metido = MEDIO_ALTO * (1 - Math.sqrt(1 - u * u));
  const aleta = i >= CAPA_ALETA && i < CAPA_ALETA + CAPAS_ALETA;
  return {
    i,
    z: +(i * ALTURA_CAPA).toFixed(2),
    sx: +(1 - (metido * AFILADO) / LARGO).toFixed(4),
    sy: +(1 - metido / MEDIO_ALTO).toFixed(4),
    forma: aleta ? "#boqueron" : "#cuerpo",
    tono: tonos[i],
    cima: i === CAPAS - 1,
  };
});

// Soporte en árbol. Cada árbol nace de un pie en la cama, sube en un tronco
// y a partir de cierta altura se abre en ramas que se curvan hasta la punta
// que toca la aleta. Las puntas caen dentro de la aleta y fuera del cuerpo, y
// ninguna rama se separa del tronco más de lo que una impresora salvaría.
const ARBOLES = [
  { pie: [6, -47], puntas: [[0, -37], [12, -40]] }, // dorsal
  { pie: [35, 44], puntas: [[30, 38], [38, 33]] }, // anal
  { pie: [129, -12], puntas: [[124, -6], [135, -19]] }, // lóbulo de arriba
  { pie: [129, 12], puntas: [[124, 6], [135, 19]] }, // lóbulo de abajo
];
const TRONCO = 0.4; // fracción de la altura del soporte que es tronco
const suave = (t) => t * t * (3 - 2 * t);
const nudo = (pie, punta, s) => {
  const t = s <= TRONCO ? 0 : suave((s - TRONCO) / (1 - TRONCO));
  return { x: pie[0] + (punta[0] - pie[0]) * t, y: pie[1] + (punta[1] - pie[1]) * t, t };
};
// En cada capa, cada rama se dibuja como un rastro desde donde estaba en la
// capa de abajo, para que el soporte se lea como una varilla continua.
const soportePorCapa = Array.from({ length: CAPA_ALETA }, (_, k) => {
  const s = k / (CAPA_ALETA - 1);
  const antes = Math.max(k - 1, 0) / (CAPA_ALETA - 1);
  return ARBOLES.flatMap(({ pie, puntas }) => {
    if (k === 0) return [{ x: pie[0], y: pie[1], r: 7 }];
    const ramas = s <= TRONCO ? [puntas[0]] : puntas;
    return ramas.flatMap((punta) => {
      const a = nudo(pie, punta, antes);
      const b = nudo(pie, punta, s);
      const r = s <= TRONCO ? 4 : 2.8 - 1.2 * b.t;
      return [1 / 3, 2 / 3, 1].map((f) => ({
        x: +(a.x + (b.x - a.x) * f).toFixed(2),
        y: +(a.y + (b.y - a.y) * f).toFixed(2),
        r: +r.toFixed(2),
      }));
    });
  });
});

const escalaCapa = (capa) =>
  `translate(${CENTRO_X} 0) scale(${capa.sx} ${capa.sy}) translate(${-CENTRO_X} 0)`;

const proyeccion = `scale(1 ${APLASTADO}) rotate(${GIRO})`;
const alturaTotal = (CAPAS * MM_POR_CAPA).toFixed(1);
const cima = capas[CAPAS - 1];
---

<figure
  class="taller"
  data-taller
  data-capas={CAPAS}
  data-altura-capa={ALTURA_CAPA}
  data-mm-capa={MM_POR_CAPA}
  data-giro={GIRO}
  data-aplastado={APLASTADO}
>
  <dl class="taller__lectura" aria-hidden="true">
    <div>
      <dt>Capa</dt>
      <dd><span data-lectura-capa>{CAPAS}</span>/{CAPAS}</dd>
    </div>
    <div>
      <dt>Altura</dt>
      <dd><span data-lectura-z>{alturaTotal}</span> mm</dd>
    </div>
    <div>
      <dt>Boquilla</dt>
      <dd><span data-lectura-temp>210</span> °C</dd>
    </div>
  </dl>

  <svg
    class="taller__vista"
    viewBox="-205 -175 410 262"
    role="img"
    aria-label="Un boquerón imprimiéndose capa a capa sobre la bancada de una impresora 3D."
  >
    <defs>
      <path id="boqueron" d={BOQUERON}></path>
      <path id="cuerpo" d={CUERPO}></path>

      <!-- La cara de arriba: el lomo recibe la luz y el vientre la pierde. -->
      <linearGradient id="pla-cara" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#cfc694"></stop>
        <stop offset="38%" stop-color="#faf7e9"></stop>
        <stop offset="62%" stop-color="#f1ecd0"></stop>
        <stop offset="100%" stop-color="#d6ce9e"></stop>
      </linearGradient>

      <!-- Cada rodaja de soporte se sombrea como un cilindro. -->
      <linearGradient id="soporte-luz" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#a39b70"></stop>
        <stop offset="60%" stop-color="#ebe5c4"></stop>
        <stop offset="100%" stop-color="#c3bb90"></stop>
      </linearGradient>

      <radialGradient id="apoyo">
        <stop offset="0%" stop-color="rgb(23 26 51 / 0.42)"></stop>
        <stop offset="55%" stop-color="rgb(23 26 51 / 0.16)"></stop>
        <stop offset="100%" stop-color="rgb(23 26 51 / 0)"></stop>
      </radialGradient>

      <radialGradient id="brasa">
        <stop offset="0%" stop-color="#ffb08f"></stop>
        <stop offset="45%" stop-color="rgb(229 89 47 / 0.55)"></stop>
        <stop offset="100%" stop-color="rgb(229 89 47 / 0)"></stop>
      </radialGradient>

      <pattern id="reticula" width="22" height="22" patternUnits="userSpaceOnUse">
        <path d="M22 0V22M0 22H22" class="taller__reticula"></path>
      </pattern>
    </defs>

    <g data-bancada transform={proyeccion}>
      <rect class="taller__bancada" x="-190" y="-110" width="380" height="220" rx="4"></rect>
      <rect x="-190" y="-110" width="380" height="220" rx="4" fill="url(#reticula)"></rect>
      <ellipse rx="162" ry="56" fill="url(#apoyo)"></ellipse>
    </g>

    {
      capas.map((capa) => (
        <g
          class="capa-grupo"
          data-capa={capa.i}
          data-z={capa.z}
          data-sx={capa.sx}
          transform={`translate(0 ${-capa.z}) ${proyeccion}`}
        >
          {soportePorCapa[capa.i]?.map((nudo) => (
            <circle class="soporte" cx={nudo.x} cy={nudo.y} r={nudo.r} />
          ))}
          <g transform={escalaCapa(capa)}>
            <use class:list={["capa", { "capa--cima": capa.cima }]} href={capa.forma} style={`fill:${capa.tono}`} />
            <use class="capa__calor" href={capa.forma} />
            {capa.cima && (
              <g class="capa__detalle">
                <path class="capa__operculo" d="M -94 -20 C -85 -8 -85 8 -94 19" />
                <path class="capa__banda" d="M -84 -1 C -40 -4 30 -3 110 -1" />
                <path class="capa__boca" d="M -150 0 L -128 3" />
                <ellipse class="capa__ojo" cx="-114" cy="-4" rx={5.5 / cima.sx} ry={5.5 / cima.sy} />
                <ellipse class="capa__brillo-ojo" cx="-115.5" cy="-5.5" rx={1.6 / cima.sx} ry={1.6 / cima.sy} />
              </g>
            )}
          </g>
        </g>
      ))
    }

    <!-- Fusor: bloque calefactor, boquilla de latón y el tubo que lo alimenta. -->
    <g class="boquilla" data-boquilla>
      <path class="boquilla__tubo" d="M 0 -58 C 0 -110 40 -130 90 -150 S 160 -190 170 -260"></path>
      <rect class="boquilla__disipador" x="-13" y="-58" width="26" height="22" rx="2"></rect>
      <path class="boquilla__aletas" d="M -13 -52 H 13 M -13 -46 H 13 M -13 -40 H 13"></path>
      <rect class="boquilla__bloque" x="-15" y="-36" width="30" height="18" rx="2"></rect>
      <path class="boquilla__punta" d="M -7 -18 H 7 L 2.5 -6 H -2.5 Z"></path>
      <circle class="boquilla__brasa" cy="-4" r="11" fill="url(#brasa)"></circle>
    </g>
  </svg>

  <figcaption class="taller__pie">
    <span>Boquerón en PLA natural, {CAPAS} capas de {MM_POR_CAPA} mm con soporte en árbol.</span>
    <button class="taller__repetir" type="button" data-reimprimir hidden>
      Volver a imprimir
    </button>
  </figcaption>
</figure>

<style>
  .taller {
    margin: 0;
  }

  .taller__vista {
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: pan-y;
  }

  .taller__bancada {
    fill: var(--cianotipo-hondo);
    stroke: var(--cianotipo-claro);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .taller__reticula {
    fill: none;
    stroke: rgb(252 252 249 / 0.13);
    stroke-width: 1;
  }

  /* Sin contorno: cada capa solo aporta su borde y su tono a la pared. */
  .capa {
    stroke: none;
  }

  .capa--cima {
    fill: url(#pla-cara) !important;
    stroke: rgb(23 26 51 / 0.18);
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }

  .capa__detalle path {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .capa__operculo,
  .capa__boca {
    stroke: rgb(23 26 51 / 0.22);
    stroke-width: 1.2;
  }

  .capa__banda {
    stroke: rgb(255 255 255 / 0.75);
    stroke-width: 3;
  }

  .capa__brillo-ojo {
    fill: rgb(255 255 255 / 0.8);
  }

  .soporte {
    fill: url(#soporte-luz);
  }

  /* El material sale caliente por la boquilla y se enfría al subir la pieza. */
  .capa__calor {
    fill: var(--filamento);
    opacity: 0;
  }

  .capa__ojo {
    fill: #2b2d3f;
  }

  /* Sin JavaScript la boquilla no tiene a dónde ir: se queda fuera. */
  .boquilla {
    display: none;
  }

  .taller.esta-viva .boquilla {
    display: inline;
  }

  .boquilla__tubo {
    fill: none;
    stroke: rgb(252 252 249 / 0.5);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .boquilla__disipador {
    fill: #c9cbd6;
  }

  .boquilla__aletas {
    stroke: #8d90a6;
    stroke-width: 1.4;
  }

  .boquilla__bloque {
    fill: var(--tinta);
  }

  .boquilla__punta {
    fill: #c9a24a;
  }

  .boquilla__brasa {
    mix-blend-mode: screen;
    transition: opacity 0.4s ease;
  }

  .taller.esta-parada .boquilla__brasa {
    opacity: 0;
  }

  /* --- Lectura de máquina -------------------------------------------- */

  .taller__lectura {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.5rem;
  }

  .taller__lectura div {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.32rem 0.65rem;
    border: 1px solid var(--linea-clara);
    border-radius: var(--r-1);
    background: rgb(23 26 51 / 0.16);
  }

  .taller__lectura dt {
    font-size: 0.78rem;
    color: rgb(252 252 249 / 0.7);
  }

  .taller__lectura dd {
    margin: 0;
    min-width: 4.6ch;
    font-family: var(--fuente-dato);
    font-size: 0.82rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--pieza);
  }

  .taller__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.6rem;
    font-size: 0.86rem;
    color: rgb(252 252 249 / 0.74);
  }

  .taller__repetir {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--linea-clara);
    border-radius: var(--r-1);
    background: none;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--pieza);
    cursor: pointer;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }

  .taller__repetir:hover {
    border-color: var(--arena);
    background: rgb(252 252 249 / 0.08);
  }

  @media (max-width: 940px) {
    .taller__vista {
      max-width: 34rem;
      margin-inline: auto;
    }
  }
</style>

<script>
  const RADIANES = Math.PI / 180;
  const DURACION_CAPA = 140; // ms por capa: la impresión entera dura unos 3 s
  const reducir = window.matchMedia("(prefers-reduced-motion: reduce)");
  const punteroFino = window.matchMedia("(pointer: fine)");

  for (const taller of document.querySelectorAll("[data-taller]")) {
    const total = Number(taller.dataset.capas);
    const alturaCapa = Number(taller.dataset.alturaCapa);
    const mmCapa = Number(taller.dataset.mmCapa);
    const giroBase = Number(taller.dataset.giro);
    const aplastadoBase = Number(taller.dataset.aplastado);

    const bancada = taller.querySelector("[data-bancada]");
    const boquilla = taller.querySelector("[data-boquilla]");
    const grupos = [...taller.querySelectorAll(".capa-grupo")];
    const lecturaCapa = taller.querySelector("[data-lectura-capa]");
    const lecturaZ = taller.querySelector("[data-lectura-z]");
    const lecturaTemp = taller.querySelector("[data-lectura-temp]");
    const repetir = taller.querySelector("[data-reimprimir]");

    const vista = { giro: giroBase, aplastado: aplastadoBase };
    const objetivo = { giro: giroBase, aplastado: aplastadoBase };
    const punta = { x: 0, y: 0 };
    let capasVisibles = total;
    let fotograma = 0;
    let inicio = 0;

    const proyectar = () => {
      const proyeccion = `scale(1 ${vista.aplastado.toFixed(3)}) rotate(${vista.giro.toFixed(2)})`;
      bancada?.setAttribute("transform", proyeccion);
      grupos.forEach((grupo) => {
        grupo.setAttribute("transform", `translate(0 ${-Number(grupo.dataset.z)}) ${proyeccion}`);
      });
    };

    const moverBoquilla = (x, y) => {
      punta.x = x;
      punta.y = y;
      boquilla?.setAttribute("transform", `translate(${x.toFixed(2)} ${y.toFixed(2)})`);
    };

    // La boquilla recorre el eje largo del pez, de la cola al morro y vuelta,
    // siempre apoyada sobre la última capa depositada.
    const seguirCapa = (capa, fase) => {
      const grupo = grupos[Math.min(capa, total - 1)];
      const recorrido = Math.sin(fase) * 128 * Number(grupo.dataset.sx);
      const angulo = vista.giro * RADIANES;
      moverBoquilla(
        Math.cos(angulo) * recorrido,
        Math.sin(angulo) * recorrido * vista.aplastado - Number(grupo.dataset.z) - alturaCapa,
      );
    };

    const leer = (capa, temperatura) => {
      if (lecturaCapa) lecturaCapa.textContent = String(capa);
      if (lecturaZ) lecturaZ.textContent = (capa * mmCapa).toFixed(1);
      if (lecturaTemp) lecturaTemp.textContent = String(Math.round(temperatura));
    };

    const depositar = (grupo) => {
      grupo.style.opacity = "1";
      grupo
        .querySelector(".capa__calor")
        ?.animate([{ opacity: 0.95 }, { opacity: 0.6, offset: 0.2 }, { opacity: 0 }], {
          duration: 1300,
          easing: "ease-out",
          fill: "forwards",
        });
    };

    // Terminada la pieza, la boquilla se aparta hacia arriba y se enfría.
    const aparcar = () => {
      const destino = { x: 150, y: -total * alturaCapa - 60 };
      let temperatura = 210;
      const paso = () => {
        moverBoquilla(punta.x + (destino.x - punta.x) * 0.08, punta.y + (destino.y - punta.y) * 0.08);
        temperatura -= 2.5;
        leer(total, Math.max(temperatura, 45));
        if (temperatura > 45) fotograma = requestAnimationFrame(paso);
      };
      fotograma = requestAnimationFrame(paso);
    };

    const imprimir = (ahora) => {
      if (!inicio) inicio = ahora;
      const transcurrido = ahora - inicio;
      const capa = Math.min(total, Math.floor(transcurrido / DURACION_CAPA) + 1);

      while (capasVisibles < capa) {
        depositar(grupos[capasVisibles]);
        capasVisibles += 1;
      }

      seguirCapa(capasVisibles - 1, transcurrido / 52);
      leer(capasVisibles, 210);

      if (capasVisibles < total) {
        fotograma = requestAnimationFrame(imprimir);
        return;
      }

      taller.classList.add("esta-parada");
      if (repetir) repetir.hidden = false;
      aparcar();
    };

    const empezar = () => {
      cancelAnimationFrame(fotograma);
      grupos.forEach((grupo) => {
        grupo.style.opacity = "0";
        grupo.querySelector(".capa__calor")?.getAnimations().forEach((a) => a.cancel());
      });
      taller.classList.remove("esta-parada");
      capasVisibles = 0;
      inicio = 0;
      fotograma = requestAnimationFrame(imprimir);
    };

    if (!reducir.matches) {
      taller.classList.add("esta-viva");
      empezar();
      repetir?.addEventListener("click", () => {
        repetir.hidden = true;
        empezar();
      });
    }

    // Girar la bancada con el puntero: solo con ratón y sin movimiento
    // reducido. La vista persigue al puntero con un poco de inercia.
    if (punteroFino.matches && !reducir.matches) {
      const zona = taller.closest("[data-zona-giro]") ?? taller;
      let siguiendo = 0;

      const seguir = () => {
        vista.giro += (objetivo.giro - vista.giro) * 0.09;
        vista.aplastado += (objetivo.aplastado - vista.aplastado) * 0.09;
        proyectar();
        const quieto =
          Math.abs(objetivo.giro - vista.giro) < 0.05 &&
          Math.abs(objetivo.aplastado - vista.aplastado) < 0.001;
        siguiendo = quieto ? 0 : requestAnimationFrame(seguir);
      };

      zona.addEventListener("pointermove", (evento) => {
        const caja = taller.getBoundingClientRect();
        const dx = (evento.clientX - (caja.left + caja.width / 2)) / caja.width;
        const dy = (evento.clientY - (caja.top + caja.height / 2)) / caja.height;
        objetivo.giro = giroBase + Math.max(-1, Math.min(1, dx)) * 26;
        objetivo.aplastado = aplastadoBase - Math.max(-1, Math.min(1, dy)) * 0.12;
        if (!siguiendo) siguiendo = requestAnimationFrame(seguir);
      });

      zona.addEventListener("pointerleave", () => {
        objetivo.giro = giroBase;
        objetivo.aplastado = aplastadoBase;
        if (!siguiendo) siguiendo = requestAnimationFrame(seguir);
      });
    }
  }
</script>
